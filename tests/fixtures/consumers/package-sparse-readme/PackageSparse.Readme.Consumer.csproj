<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <IsTestProject>false</IsTestProject>
    <IsPackable>false</IsPackable>
    <AssemblyName>PackageSparse.Readme.Consumer</AssemblyName>
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <CompilerGeneratedFilesOutputPath>$(BaseIntermediateOutputPath)$(Configuration)/$(TargetFramework)/generated</CompilerGeneratedFilesOutputPath>
    <ReadmeGeneratedCodeDirectory>$(MSBuildThisFileDirectory)../../../../docs/generated-code</ReadmeGeneratedCodeDirectory>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Remove="TUnit;Shouldly" />
    <Using Remove="Shouldly" />
  </ItemGroup>
  <ItemGroup Condition="'$(SparseTypesPackageVersion)' == ''">
    <ProjectReference Include="../../../../src/SparseTypes/SparseTypes.csproj" />
    <ProjectReference
      Include="../../../../src/SparseTypes.Generator/SparseTypes.Generator.csproj"
      OutputItemType="Analyzer"
      ReferenceOutputAssembly="false"
    />
  </ItemGroup>
  <ItemGroup Condition="'$(SparseTypesPackageVersion)' != ''">
    <PackageReference Include="SparseTypes" Version="$(SparseTypesPackageVersion)" />
  </ItemGroup>
  <!-- Roslyn groups emitted files by generator; keep the documentation snapshot flat. -->
  <Target Name="CopyReadmeGeneratedCode" AfterTargets="CoreCompile">
    <ItemGroup>
      <_ReadmeGeneratedSource Include="$(CompilerGeneratedFilesOutputPath)/**/*.cs" />
    </ItemGroup>
    <Error
      Condition="'@(_ReadmeGeneratedSource)' == ''"
      Text="The README consumer did not emit any generated source files."
    />
    <Delete Files="$(ReadmeGeneratedCodeDirectory)/*.g.cs" />
    <MakeDir Directories="$(ReadmeGeneratedCodeDirectory)" />
    <Copy
      SourceFiles="@(_ReadmeGeneratedSource)"
      DestinationFiles="@(_ReadmeGeneratedSource->'$(ReadmeGeneratedCodeDirectory)/%(Filename)%(Extension)')"
    />
  </Target>
</Project>
