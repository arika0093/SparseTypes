<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>SparseTypes.PublicApi.Tests</RootNamespace>
    <AssemblyName>SparseTypes.PublicApi.Tests</AssemblyName>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="PublicApiGenerator" Version="11.5.4" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.13" />
    <!-- Test-runtime only: matches the generator's compile-time Roslyn (4.3.1) so
      GetExportedTypes reflection can load the CodeFixProvider base chain
      (Microsoft.CodeAnalysis.Workspaces 4.3.0.0). The generator itself keeps
      PrivateAssets="all" so no consumer payload changes. -->
    <PackageReference
      Include="Microsoft.CodeAnalysis.CSharp.Workspaces"
      Version="4.3.1"
    />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/SparseTypes/SparseTypes.csproj" />
    <ProjectReference Include="../../src/SparseTypes.Generator/SparseTypes.Generator.csproj" />
    <ProjectReference Include="../../src/SparseTypes.Blazor/SparseTypes.Blazor.csproj" />
    <ProjectReference Include="../../src/SparseTypes.EntityFrameworkCore/SparseTypes.EntityFrameworkCore.csproj" />
    <ProjectReference Include="../SparseTypes.GeneratedApiFixtures/SparseTypes.GeneratedApiFixtures.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="Approvals/**/*.approved.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
