        /// <summary>The live editable model. The UI or application mutates this instance directly.</summary>
        [EditorBrowsable(EditorBrowsableState.Advanced)]
        public TModel Model
        {
            get
            {
                DisableHasChangesCache();
                return _model;
            }
            private set => _model = value;
        }

        /// <summary>Returns the live model for trusted framework use without affecting the change cache.</summary>
        public TModel GetModelForFrameworkAccess() => _model;

        /// <summary>A stable typed observable proxy over <see cref="Model"/>.</summary>
        public TObservable Observable => _observable;

        /// <summary>The revision of the retained baseline.</summary>
        public long BaselineRevision => _baselineRevision;

        /// <summary>Whether the current model differs semantically from the retained baseline.</summary>
        public bool HasChanges
        {
            get
            {
                if (_cacheObservableChanges && _lastObservedSnapshotValid && _hasChangesCacheValid) return _cachedHasChanges;
                TChangeSet changes;
                try { changes = CreateChangeSet(); } catch (InvalidOperationException exception) when (IsDuplicateKeyError(exception)) { return true; }
                if (_cacheObservableChanges && _lastObservedSnapshotValid && _hasChangesCacheValid) return _cachedHasChanges;
                if (_cacheObservableChanges && _lastObservedSnapshotValid) {
                    CacheHasChanges(changes);
                    return _cachedHasChanges;
                }
                return !_isEmpty(changes);
            }
        }

        /// <summary>Raised when session state or its observable model may have changed.</summary>
        public event PropertyChangedEventHandler? PropertyChanged;

        /// <summary>Raised with the leaf transitions produced by each observable edit.</summary>
        public event Action<TChangeSet>? TransitionObserved;

        /// <summary>Runs observable edits as one transition notification, including nested batches.</summary>
        public void BatchEdit(Action edit)
        {
            if (edit is null) throw new ArgumentNullException(nameof(edit));
            var isOuterBatch = _batchDepth == 0;
            if (isOuterBatch) {
                _batchStart = _lastObserved;
                _batchDirty = false;
                _batchPropertyChanged = false;
                _batchOnChanged = false;
            }
            _batchDepth++;
            try { edit(); } finally {
                _batchDepth--;
                if (isOuterBatch) CompleteBatchEdit();
            }
        }

        /// <summary>Derives the baseline-aware change set between the retained baseline and current model.</summary>
        public TChangeSet CreateChangeSet()
        {
            if (_cacheObservableChanges && _lastObservedSnapshotValid) return GetChangeSetForObservedSnapshot();
            return CreateChangeSetFromLiveModel();
        }

        /// <summary>Derives a change set from a fresh capture of the live model.</summary>
        public TChangeSet CreateChangeSetFromLiveModel()
        {
            var current = __OPTIONAL_TYPE__<TFragment?>.Present(_fromModel(_model));
            return _between(_baseline, current);
        }

        /// <summary>Derives the baseline-free patch from the current baseline-aware change set.</summary>
        public TPatch CreatePatch() => _toPatch(CreateChangeSet());

        /// <summary>Enumerates changed generated member paths from the current model.</summary>
        public IReadOnlyList<__PATH_TYPE__> EnumerateChangedPaths()
        {
            if (_enumerateChangedPaths is null) throw new NotSupportedException("This edit session does not provide generated change paths.");
            return _enumerateChangedPaths(CreateChangeSet());
        }

        /// <summary>Applies a change set in place after checking its before-state.</summary>
        public bool TryApplyInPlace(TChangeSet changes, out IReadOnlyList<__CONFLICT_TYPE__>? conflicts)
        {
            if (changes is null) throw new ArgumentNullException(nameof(changes));
            if (_tryApplyInPlace is not null) {
                (bool Succeeded, IReadOnlyList<__CONFLICT_TYPE__>? Conflicts) directResult;
                try { directResult = _tryApplyInPlace(changes, _model); } catch {
                    ResynchronizeAfterFailedMutation();
                    throw;
                }
                if (!directResult.Succeeded) {
                    conflicts = directResult.Conflicts;
                    return false;
                }
                conflicts = null;
                RefreshAfterModelMutation();
                return true;
            }
            if (_tryApplyTo is null || _writeModel is null) throw new NotSupportedException("This model cannot be updated in place.");
            var result = _tryApplyTo(changes, _model);
            if (result.Conflicts is not null) {
                conflicts = result.Conflicts;
                return false;
            }
            if (result.Updated is null) throw new InvalidOperationException("Applying the change set did not produce a model.");
            var committed = false;
            try {
                _writeModel(_model, result.Updated);
                committed = true;
            }
            finally { if (!committed) ResynchronizeAfterFailedMutation(); }
            conflicts = null;
            RefreshAfterModelMutation();
            return true;
        }

        /// <summary>Applies a change set in place or throws when its before-state conflicts.</summary>
        public void ApplyInPlace(TChangeSet changes)
        {
            if (!TryApplyInPlace(changes, out _)) throw new InvalidOperationException("The change set cannot be applied to the current model because its before-state conflicts.");
        }

        /// <summary>Reverts the current model to its retained baseline in place.</summary>
        public void RevertChanges()
        {
            if (!TryRevertChanges(out _)) {
                throw new InvalidOperationException(
                    "The pending changes cannot be reverted in place because their "
                        + "before-state conflicts or they include members that cannot be "
                        + "written to an existing model. Use TryRevertChanges for structured "
                        + "conflicts."
                );
            }
        }

        /// <summary>Reverts the current model to its retained baseline when possible in place.</summary>
        public bool TryRevertChanges(out IReadOnlyList<__CONFLICT_TYPE__>? conflicts)
        {
            if (_invert is null) throw new NotSupportedException("This edit session cannot invert its change sets.");
            TChangeSet changes;
            try { changes = CreateChangeSet(); } catch (InvalidOperationException exception) when (IsInvalidKeyedStateError(exception)) {
                RevertFromInvalidKeyedState(exception);
                conflicts = null;
                return true;
            }
            if (_isEmpty(changes)) {
                conflicts = null;
                return true;
            }
            TChangeSet inverted;
            try { inverted = _invert(changes); } catch (InvalidOperationException exception) when (IsInvalidKeyedStateError(exception)) {
                RevertFromInvalidKeyedState(exception);
                conflicts = null;
                return true;
            }
            try { return TryApplyInPlace(inverted, out conflicts); } catch (InvalidOperationException exception) when (IsInvalidKeyedStateError(exception)) {
                RevertFromInvalidKeyedState(exception);
                conflicts = null;
                return true;
            }
        }

        /// <summary>Reloads authoritative server state and rebases pending local edits onto it.</summary>
        public __REBASE_RESULT_TYPE__ Reload(TModel serverState)
        {
            if (serverState is null) throw new ArgumentNullException(nameof(serverState));
            if (_rebase is null || _tryApplyTo is null || _writeModel is null) throw new NotSupportedException("This model cannot be reloaded in place.");
            var serverBaseline = __OPTIONAL_TYPE__<TFragment?>.Present(_fromModel(serverState));
            _between(serverBaseline, _baseline);
            var rebased = _rebase(CreateChangeSet(), serverState);
            if (rebased.HasConflicts) return rebased;
            var applied = _tryApplyTo(rebased.Rebased, serverState);
            if (applied.Conflicts is not null) return new __REBASE_RESULT_TYPE__(rebased.Rebased, applied.Conflicts);
            if (applied.Updated is null) throw new InvalidOperationException("Reloading did not produce a model.");
            try {
                var drift = _between(__OPTIONAL_TYPE__<TFragment?>.Present(_fromModel(_model)), __OPTIONAL_TYPE__<TFragment?>.Present(_fromModel(applied.Updated)));
                if (!_isEmpty(drift)) {
                    var probe = _tryApplyTo(drift, _model);
                    if (probe.Conflicts is not null) return new __REBASE_RESULT_TYPE__(rebased.Rebased, probe.Conflicts);
                }
            }
            catch (InvalidOperationException exception) when (IsInvalidKeyedStateError(exception)) {
            }
            try { _writeModel(_model, applied.Updated); } catch {
                ResynchronizeAfterFailedMutation();
                throw;
            }
            SetBaseline(serverBaseline);
            RefreshAfterModelMutation();
            return rebased;
        }

        /// <summary>Reconciles a submitted change set with the authoritative persisted model.</summary>
        public bool TryReconcile<TMap>(TChangeSet submitted, TModel persisted, Func<TModel, TModel, (TMap? Map, string? Error)> buildMap, Func<TModel, TModel, TModel, TMap?, TChangeSet, string?> retarget, out string? error)
            where TMap : class
        {
            if (submitted is null) throw new ArgumentNullException(nameof(submitted));
            if (persisted is null) throw new ArgumentNullException(nameof(persisted));
            if (buildMap is null) throw new ArgumentNullException(nameof(buildMap));
            if (retarget is null) throw new ArgumentNullException(nameof(retarget));
            if (_baselineToModel is null || _writeModel is null) throw new NotSupportedException("This edit session cannot reconcile submissions because it was built without baseline materialization or in-place write support.");
            error = null;
            var persistedBaseline = __OPTIONAL_TYPE__<TFragment?>.Present(_fromModel(persisted));
            try {
                var reconcileCurrent = _between(persistedBaseline, __OPTIONAL_TYPE__<TFragment?>.Present(_fromModel(_model)));
                if (_isEmpty(reconcileCurrent)) {
                    if (ReferenceEquals(submitted, _lastReconciledSubmission)) {
                        SetBaseline(persistedBaseline);
                        SetObservedSnapshot(persistedBaseline);
                        RefreshAfterModelMutation();
                        error = null;
                        return true;
                    }
                    var verifiedAdvanced = _advanceBaseline(submitted, _baseline);
                    if (verifiedAdvanced.IsPresent) {
                        var verifiedValue = verifiedAdvanced.Value;
                        if (verifiedValue is null) {
                            error = "Advancing the baseline did not produce a valid model state.";
                            return false;
                        }
                        var verifiedAfter = _baselineToModel(verifiedValue);
                        var verifiedPending = _between(__OPTIONAL_TYPE__<TFragment?>.Present(_fromModel(verifiedAfter)), __OPTIONAL_TYPE__<TFragment?>.Present(_fromModel(_model)));
                        if (_isEmpty(verifiedPending)) {
                            SetBaseline(persistedBaseline);
                            SetObservedSnapshot(persistedBaseline);
                            _lastReconciledSubmission = submitted;
                            RefreshAfterModelMutation();
                            error = null;
                            return true;
                        }
                    }
                }
            }
            catch (InvalidOperationException) {
            }
            TModel submittedAfter;
            try {
                var advanced = _advanceBaseline(submitted, _baseline);
                if (!advanced.IsPresent || advanced.Value is null) {
                    error = "Advancing the baseline did not produce a valid model state.";
                    return false;
                }
                submittedAfter = _baselineToModel(advanced.Value);
            }
            catch (InvalidOperationException exception) {
                error = "The submitted change set is stale or incompatible with the retained baseline: " + exception.Message;
                return false;
            }
            try { _ = _between(_baseline, persistedBaseline); } catch (InvalidOperationException exception) {
                error = "The persisted model cannot serve as a keyed baseline: " + exception.Message;
                return false;
            }
            TChangeSet pending;
            try { pending = _between(__OPTIONAL_TYPE__<TFragment?>.Present(_fromModel(submittedAfter)), __OPTIONAL_TYPE__<TFragment?>.Present(_fromModel(_model))); } catch (InvalidOperationException exception) {
                error = "The current model cannot be diffed against the submitted state: " + exception.Message;
                return false;
            }
            var (map, mapError) = buildMap(submittedAfter, persisted);
            if (mapError is not null || map is null) {
                error = mapError ?? "Temporary correlation did not produce a mapping.";
                return false;
            }
            var backup = CloneLiveModel(_model);
            var backupSnapshot = __OPTIONAL_TYPE__<TFragment?>.Present(_fromModel(backup));
            string? retargetError;
            try { retargetError = retarget(_model, submittedAfter, persisted, map, pending); } catch {
                try { RestoreReconcileBackup(backup, backupSnapshot); } catch {
                }
                ResynchronizeAfterFailedMutation();
                throw;
            }
            if (retargetError is not null) {
                try { RestoreReconcileBackup(backup, backupSnapshot); } catch {
                    ResynchronizeAfterFailedMutation();
                    throw;
                }
                RefreshAfterModelMutation();
                error = retargetError;
                return false;
            }
            try { _ = _between(persistedBaseline, __OPTIONAL_TYPE__<TFragment?>.Present(_fromModel(_model))); } catch (InvalidOperationException exception) {
                try { _writeModel(_model, backup); } catch {
                    ResynchronizeAfterFailedMutation();
                    throw;
                }
                RefreshAfterModelMutation();
                error = "Reconciling produced a model that cannot serve as a keyed baseline: " + exception.Message;
                return false;
            }
            SetBaseline(persistedBaseline);
            SetObservedSnapshot(persistedBaseline);
            _lastReconciledSubmission = submitted;
            RefreshAfterModelMutation();
            return true;
        }

        /// <summary>Reconciles a submission, adopts authoritative values, and preserves post-submit edits.</summary>
        public bool TryReconcileAndApply<TMap>(TChangeSet submitted, TModel persisted, Func<TModel, TModel, (TMap? Map, string? Error)> buildMap, Func<TModel, TModel, TModel, TMap?, TChangeSet?, string?> retarget, Func<string, __CONFLICT_TYPE__> createReconcileConflict, out IReadOnlyList<__CONFLICT_TYPE__>? conflicts)
            where TMap : class
        {
            if (submitted is null) throw new ArgumentNullException(nameof(submitted));
            if (persisted is null) throw new ArgumentNullException(nameof(persisted));
            if (buildMap is null) throw new ArgumentNullException(nameof(buildMap));
            if (retarget is null) throw new ArgumentNullException(nameof(retarget));
            if (createReconcileConflict is null) throw new ArgumentNullException(nameof(createReconcileConflict));
            if (_baselineToModel is null || _writeModel is null || _tryApplyTo is null || _rebase is null) throw new NotSupportedException("This edit session cannot reconcile submissions because it was built without baseline materialization, rebase, or in-place write support.");
            conflicts = null;
            var persistedBaseline = __OPTIONAL_TYPE__<TFragment?>.Present(_fromModel(persisted));
            TModel submittedAfter;
            try {
                var advanced = _advanceBaseline(submitted, _baseline);
                if (!advanced.IsPresent || advanced.Value is null) return Fail("Advancing the baseline did not produce a valid model state.", out conflicts);
                submittedAfter = _baselineToModel(advanced.Value);
                _ = _between(_baseline, persistedBaseline);
            }
            catch (InvalidOperationException exception) { return Fail("The submitted change set or persisted model is stale or incompatible: " + exception.Message, out conflicts); }
            TChangeSet pending;
            try { pending = _between(__OPTIONAL_TYPE__<TFragment?>.Present(_fromModel(submittedAfter)), __OPTIONAL_TYPE__<TFragment?>.Present(_fromModel(_model))); } catch (InvalidOperationException exception) { return Fail("The current model cannot be diffed against the submitted state: " + exception.Message, out conflicts); }
            var (map, mapError) = buildMap(submittedAfter, persisted);
            if (mapError is not null || map is null) return Fail(mapError ?? "Temporary correlation did not produce a mapping.", out conflicts);
            TModel mappedSubmitted;
            TModel mappedCurrent;
            try {
                mappedSubmitted = CloneLiveModel(submittedAfter);
                mappedCurrent = CloneLiveModel(_model);
                var submittedError = retarget(mappedSubmitted, submittedAfter, persisted, map, null);
                if (submittedError is not null) return Fail(submittedError, out conflicts);
                var currentError = retarget(mappedCurrent, submittedAfter, persisted, map, pending);
                if (currentError is not null) return Fail(currentError, out conflicts);
            }
            catch (InvalidOperationException exception) { return Fail("Temporary identities could not be reconciled: " + exception.Message, out conflicts); }
            TChangeSet mappedPending;
            try { mappedPending = _between(__OPTIONAL_TYPE__<TFragment?>.Present(_fromModel(mappedSubmitted)), __OPTIONAL_TYPE__<TFragment?>.Present(_fromModel(mappedCurrent))); } catch (InvalidOperationException exception) { return Fail("The retargeted model cannot be diffed: " + exception.Message, out conflicts); }
            __REBASE_RESULT_TYPE__ rebased;
            try { rebased = _rebase(mappedPending, persisted); } catch (InvalidOperationException exception) { return Fail("The post-submit changes could not be rebased: " + exception.Message, out conflicts); }
            if (rebased.HasConflicts) {
                conflicts = rebased.Conflicts;
                return false;
            }
            (TModel? Updated, IReadOnlyList<__CONFLICT_TYPE__>? Conflicts) applied;
            try { applied = _tryApplyTo(rebased.Rebased, persisted); } catch (InvalidOperationException exception) { return Fail("The rebased changes could not be applied: " + exception.Message, out conflicts); }
            if (applied.Conflicts is not null) {
                conflicts = applied.Conflicts;
                return false;
            }
            if (applied.Updated is null) return Fail("Applying the post-submit changes did not produce a model.", out conflicts);
            try { _ = _between(persistedBaseline, __OPTIONAL_TYPE__<TFragment?>.Present(_fromModel(applied.Updated))); } catch (InvalidOperationException exception) { return Fail("The reconciled model cannot serve as a keyed baseline: " + exception.Message, out conflicts); }
            var backup = CloneLiveModel(_model);
            var backupSnapshot = __OPTIONAL_TYPE__<TFragment?>.Present(_fromModel(backup));
            try { _writeModel(_model, applied.Updated); } catch {
                try { RestoreReconcileBackup(backup, backupSnapshot); } catch {
                }
                ResynchronizeAfterFailedMutation();
                throw;
            }
            SetBaseline(persistedBaseline);
            SetObservedSnapshot(persistedBaseline);
            _lastReconciledSubmission = submitted;
            RefreshAfterModelMutation();
            conflicts = null;
            return true;
            bool Fail(string reason, out IReadOnlyList<__CONFLICT_TYPE__>? result)
            {
                result = new[] { createReconcileConflict(reason) };
                return false;
            }
        }

        /// <summary>Accepts the current model state as the new baseline.</summary>
        public void AcceptChanges()
        {
            var candidate = __OPTIONAL_TYPE__<TFragment?>.Present(_fromModel(_model));
            _between(candidate, _baseline);
            SetBaseline(candidate);
            SetObservedSnapshot(candidate);
            OnPropertyChanged(nameof(HasChanges));
        }

        /// <summary>Advances the retained baseline by the supplied transition without touching the live model.</summary>
        public void AcceptChanges(TChangeSet changes)
        {
            if (changes is null) throw new ArgumentNullException(nameof(changes));
            var advanced = _advanceBaseline(changes, _baseline);
            if (!advanced.IsPresent || advanced.Value is null) throw new InvalidOperationException("Advancing the baseline did not produce a valid model state.");
            try { _between(advanced, _baseline); } catch (InvalidOperationException ex) { throw new InvalidOperationException("Accepting this change set would retain an invalid baseline, such as unassigned keyed sentinels.", ex); }
            SetBaseline(advanced);
            InvalidateHasChangesCache();
            OnPropertyChanged(nameof(HasChanges));
        }

        /// <summary>Creates an independent speculative branch of this session.</summary>
        public virtual EditSessionCore<TModel, TFragment, TPatch, TChangeSet, TObservable> Fork()
        {
            var forkPoint = _fromModel(_model);
            var forkLive = CloneLiveModel(_model);
            return CreateBranched(forkLive, __OPTIONAL_TYPE__<TFragment?>.Present(forkPoint), _rootId, onChanged: null);
        }

        /// <summary>Attempts to merge the changes of a fork into this session without modifying either session.</summary>
        public virtual bool TryMergeFrom(EditSessionCore<TModel, TFragment, TPatch, TChangeSet, TObservable> fork, out EditSessionCore<TModel, TFragment, TPatch, TChangeSet, TObservable>? merged, out IReadOnlyList<__CONFLICT_TYPE__>? conflicts)
        {
            if (fork is null) throw new ArgumentNullException(nameof(fork));
            if (ReferenceEquals(this, fork)) throw new InvalidOperationException("Cannot merge an edit session into itself. Fork the session first and merge the fork.");
            if (fork._rootId != _rootId) throw new InvalidOperationException("Cannot merge an edit session from an unrelated branch lineage. Only sessions created by Fork share a lineage.");
            if (_rebase is null || _tryApplyTo is null || _baselineToModel is null) throw new NotSupportedException("This edit session cannot merge forks because it was built without rebase or baseline materialization support.");
            if (!_baseline.IsPresent || _baseline.Value is null) throw new InvalidOperationException("Cannot merge into an edit session with a missing baseline.");
            var forkChanges = fork.CreateChangeSet();
            var rebased = _rebase(forkChanges, _model);
            if (rebased.HasConflicts) {
                merged = null;
                conflicts = rebased.Conflicts;
                return false;
            }
            var applied = _tryApplyTo(rebased.Rebased, _model);
            if (applied.Conflicts is not null) {
                merged = null;
                conflicts = applied.Conflicts;
                return false;
            }
            if (applied.Updated is null) throw new InvalidOperationException("Merging the fork did not produce a model.");
            var detached = CloneLiveModel(applied.Updated);
            _between(_baseline, __OPTIONAL_TYPE__<TFragment?>.Present(_fromModel(detached)));
            merged = CreateBranched(detached, _baseline, _rootId, _onChanged);
            conflicts = null;
            return true;
        }

        /// <summary>Creates a session of this runtime type with an explicit baseline and lineage.</summary>
        protected virtual EditSessionCore<TModel, TFragment, TPatch, TChangeSet, TObservable> CreateBranched(TModel live, __OPTIONAL_TYPE__<TFragment?> baseline, Guid rootId, Action? onChanged)
        {
            if (live is null) throw new ArgumentNullException(nameof(live));
            if (!baseline.IsPresent || baseline.Value is null) throw new InvalidOperationException("Cannot branch an edit session with a missing baseline.");
            var branched = new EditSessionCore<TModel, TFragment, TPatch, TChangeSet, TObservable>(live, baseline.Value, _fromModel, _between, _toPatch, _isEmpty, _advanceBaseline, _toObservable, onChanged, _tryApplyTo, _writeModel, _invert, _rebase, _enumerateChangedPaths, _refreshObservable, _initialCacheObservableChanges, _baselineToModel, _tryApplyInPlace);
            branched.AdoptBranchRoot(rootId);
            return branched;
        }

        /// <summary>Initializes a session with observable notifications.</summary>
        internal EditSessionCore(TModel model, TFragment baseline, Func<TModel, TFragment> fromModel, Func<__OPTIONAL_TYPE__<TFragment?>, __OPTIONAL_TYPE__<TFragment?>, TChangeSet> between, Func<TChangeSet, TPatch> toPatch, Func<TChangeSet, bool> isEmpty, Func<TChangeSet, __OPTIONAL_TYPE__<TFragment?>, __OPTIONAL_TYPE__<TFragment?>> advanceBaseline, Func<TModel, Action?, TObservable> toObservable, Action? onChanged = null)
            : this(
                model,
                baseline,
                fromModel,
                between,
                toPatch,
                isEmpty,
                advanceBaseline,
                (value, changed, _) => toObservable(value, changed),
                onChanged
            ) { }

        /// <summary>Initializes a session with full in-place support.</summary>
        internal EditSessionCore(TModel model, TFragment baseline, Func<TModel, TFragment> fromModel, Func<__OPTIONAL_TYPE__<TFragment?>, __OPTIONAL_TYPE__<TFragment?>, TChangeSet> between, Func<TChangeSet, TPatch> toPatch, Func<TChangeSet, bool> isEmpty, Func<TChangeSet, __OPTIONAL_TYPE__<TFragment?>, __OPTIONAL_TYPE__<TFragment?>> advanceBaseline, Func<TModel, Action?, Action?, TObservable> toObservable, Action? onChanged, Func<TChangeSet, TModel, (TModel? Updated, IReadOnlyList<__CONFLICT_TYPE__>? Conflicts)>? tryApplyTo = null, Action<TModel, TModel>? writeModel = null, Func<TChangeSet, TChangeSet>? invert = null, Func<TChangeSet, TModel, __REBASE_RESULT_TYPE__>? rebase = null, Func<TChangeSet, IReadOnlyList<__PATH_TYPE__>>? enumerateChangedPaths = null, Action<TObservable>? refreshObservable = null, bool cacheObservableChanges = false, Func<TFragment, TModel>? baselineToModel = null, Func<TChangeSet, TModel, (bool Succeeded, IReadOnlyList<__CONFLICT_TYPE__>? Conflicts)>? tryApplyInPlace = null)
        {
            Model = model;
            _fromModel = fromModel;
            _between = between;
            _toPatch = toPatch;
            _isEmpty = isEmpty;
            _advanceBaseline = advanceBaseline;
            _toObservable = toObservable;
            _tryApplyTo = tryApplyTo;
            _tryApplyInPlace = tryApplyInPlace;
            _writeModel = writeModel;
            _invert = invert;
            _rebase = rebase;
            _enumerateChangedPaths = enumerateChangedPaths;
            _refreshObservable = refreshObservable;
            _onChanged = onChanged;
            _cacheObservableChanges = cacheObservableChanges;
            _initialCacheObservableChanges = cacheObservableChanges;
            _baselineToModel = baselineToModel;
            _rootId = Guid.NewGuid();
            _baseline = __OPTIONAL_TYPE__<TFragment?>.Present(baseline);
            _lastObserved = __OPTIONAL_TYPE__<TFragment?>.Present(fromModel(model));
            _observable = toObservable(model, OnObservableMutation, DisableHasChangesCache);
        }

        internal void AdoptBranchRoot(Guid rootId) => _rootId = rootId;

        internal bool IsInSameLineage(EditSessionCore<TModel, TFragment, TPatch, TChangeSet, TObservable> other) =>
            other is not null && _rootId == other._rootId;

        internal void RefreshAfterExternalMutation() => RefreshAfterModelMutation();

        private const string DuplicateKeyErrorMessage = "Duplicate key in keyed collection.";
        private const string UnassignedBaselineErrorMessage = "An unassigned key cannot appear in the baseline of a keyed collection transition.";
        private const string UnassignedChangeSetBaselineErrorMessage =
            "An unassigned key cannot appear in the current baseline of a keyed ChangeSet.";
        private readonly Func<TModel, TFragment> _fromModel;
        private readonly Func<__OPTIONAL_TYPE__<TFragment?>, __OPTIONAL_TYPE__<TFragment?>, TChangeSet> _between;
        private readonly Func<TChangeSet, TPatch> _toPatch;
        private readonly Func<TChangeSet, bool> _isEmpty;
        private readonly Func<TChangeSet, __OPTIONAL_TYPE__<TFragment?>, __OPTIONAL_TYPE__<TFragment?>> _advanceBaseline;
        private readonly TObservable _observable;
        private readonly Func<TChangeSet, TModel, (TModel? Updated, IReadOnlyList<__CONFLICT_TYPE__>? Conflicts)>? _tryApplyTo;
        private readonly Func<TChangeSet, TModel, (bool Succeeded, IReadOnlyList<__CONFLICT_TYPE__>? Conflicts)>? _tryApplyInPlace;
        private readonly Action<TModel, TModel>? _writeModel;
        private readonly Func<TChangeSet, TChangeSet>? _invert;
        private readonly Func<TChangeSet, TModel, __REBASE_RESULT_TYPE__>? _rebase;
        private readonly Func<TChangeSet, IReadOnlyList<__PATH_TYPE__>>? _enumerateChangedPaths;
        private readonly Func<TFragment, TModel>? _baselineToModel;
        private readonly Func<TModel, Action?, Action?, TObservable> _toObservable;
        private readonly Action<TObservable>? _refreshObservable;
        private readonly Action? _onChanged;
        private readonly bool _initialCacheObservableChanges;
        private Guid _rootId;
        private bool _cacheObservableChanges;
        private bool _hasChangesCacheValid;
        private bool _cachedHasChanges;
        private bool _cachedChangeSetValid;
        private bool _lastObservedSnapshotValid;
        private long _observedGeneration;
        private long _cachedChangeSetGeneration;
        private long _cachedChangeSetBaselineRevision;
        private TChangeSet? _cachedChangeSet;
        private __OPTIONAL_TYPE__<TFragment?> _lastObserved;
        private __OPTIONAL_TYPE__<TFragment?> _baseline;
        private long _baselineRevision;

        private TChangeSet? _lastReconciledSubmission;
        private __OPTIONAL_TYPE__<TFragment?> _batchStart;
        private int _batchDepth;
        private bool _batchDirty;
        private bool _batchPropertyChanged;
        private bool _batchOnChanged;

        private TModel _model = null!;

        private void SetBaseline(__OPTIONAL_TYPE__<TFragment?> baseline)
        {
            var revision = checked(_baselineRevision + 1);
            _baseline = baseline;
            _baselineRevision = revision;
            InvalidateHasChangesCache();
        }

        private void SetObservedSnapshot(__OPTIONAL_TYPE__<TFragment?> snapshot)
        {
            _lastObserved = snapshot;
            _observedGeneration = unchecked(_observedGeneration + 1);
            _lastObservedSnapshotValid = true;
            InvalidateHasChangesCache();
        }

        private void MarkObservedSnapshotInvalid()
        {
            _observedGeneration = unchecked(_observedGeneration + 1);
            _lastObservedSnapshotValid = false;
            InvalidateHasChangesCache();
        }

        private TChangeSet GetChangeSetForObservedSnapshot()
        {
            if (_cachedChangeSetValid && _cachedChangeSetGeneration == _observedGeneration && _cachedChangeSetBaselineRevision == _baselineRevision) return _cachedChangeSet!;
            var changes = _between(_baseline, _lastObserved);
            _cachedChangeSet = changes;
            _cachedChangeSetGeneration = _observedGeneration;
            _cachedChangeSetBaselineRevision = _baselineRevision;
            _cachedChangeSetValid = true;
            return changes;
        }

        private void OnObservableChanged()
        {
            if (_batchDepth > 0) {
                _batchDirty = true;
                MarkObservedSnapshotInvalid();
                OnPropertyChanged(nameof(HasChanges));
                return;
            }
            MarkObservedSnapshotInvalid();
            var current = __OPTIONAL_TYPE__<TFragment?>.Present(_fromModel(_model));
            TChangeSet transition;
            try { transition = _between(_lastObserved, current); } catch (InvalidOperationException exception) when (IsDuplicateKeyError(exception)) {
                OnPropertyChanged(nameof(HasChanges));
                return;
            }
            SetObservedSnapshot(current);
            if (_batchDepth == 0 && !_isEmpty(transition)) TransitionObserved?.Invoke(transition);
            OnPropertyChanged(nameof(HasChanges));
        }

        private void RefreshAfterModelMutation()
        {
            MarkObservedSnapshotInvalid();
            var current = __OPTIONAL_TYPE__<TFragment?>.Present(_fromModel(_model));
            var transition = _between(_lastObserved, current);
            SetObservedSnapshot(current);
            _refreshObservable?.Invoke(_observable);
            if (_batchDepth == 0 && !_isEmpty(transition)) TransitionObserved?.Invoke(transition);
            OnPropertyChanged(nameof(HasChanges));
        }

        /// <summary>Resynchronizes observations after arbitrary user code partially mutated the live model and threw.</summary>
        private void ResynchronizeAfterFailedMutation()
        {
            try { RefreshAfterModelMutation(); } catch {
                InvalidateHasChangesCache();
                try { _refreshObservable?.Invoke(_observable); } catch {
                }
                try { OnPropertyChanged(nameof(HasChanges)); } catch {
                }
            }
        }

        /// <summary>Restores the live model from a reconcile backup when it diverged.</summary>
        private void RestoreReconcileBackup(TModel backup, __OPTIONAL_TYPE__<TFragment?> backupSnapshot)
        {
            var restoreBackup = true;
            try { restoreBackup = !_isEmpty(_between(backupSnapshot, __OPTIONAL_TYPE__<TFragment?>.Present(_fromModel(_model)))); } catch (InvalidOperationException) { restoreBackup = true; }
            if (restoreBackup) _writeModel!(_model, backup);
        }

        private void DisableHasChangesCache()
        {
            _cacheObservableChanges = false;
            InvalidateHasChangesCache();
        }

        private void InvalidateHasChangesCache()
        {
            _hasChangesCacheValid = false;
            _cachedChangeSetValid = false;
        }

        private void CacheHasChanges(TChangeSet changes)
        {
            _cachedHasChanges = !_isEmpty(changes);
            _hasChangesCacheValid = true;
        }

        private void OnObservableMutation()
        {
            OnObservableChanged();
            if (_batchDepth > 0) _batchOnChanged = true;
            else _onChanged?.Invoke();
        }

        private void CompleteBatchEdit()
        {
            var start = _batchStart;
            _batchStart = default;
            var notifyPropertyChanged = _batchPropertyChanged;
            _batchPropertyChanged = false;
            var notifyOnChanged = _batchOnChanged;
            _batchOnChanged = false;
            var dirty = _batchDirty;
            _batchDirty = false;
            if (dirty) PublishBatchedTransition(start);
            else if (start.IsPresent) {
            }
            if (notifyPropertyChanged) OnPropertyChanged(nameof(HasChanges));
            if (notifyOnChanged) _onChanged?.Invoke();
        }

        private void PublishBatchedTransition(__OPTIONAL_TYPE__<TFragment?> start)
        {
            var current = __OPTIONAL_TYPE__<TFragment?>.Present(_fromModel(_model));
            if (!start.IsPresent) {
                SetObservedSnapshot(current);
                return;
            }
            TChangeSet transition;
            try { transition = _between(start, current); } catch (InvalidOperationException exception) when (IsDuplicateKeyError(exception)) {
                MarkObservedSnapshotInvalid();
                return;
            }
            SetObservedSnapshot(current);
            if (!_isEmpty(transition)) TransitionObserved?.Invoke(transition);
        }

        private static bool IsDuplicateKeyError(InvalidOperationException exception) =>
            string.Equals(exception.Message, DuplicateKeyErrorMessage, StringComparison.Ordinal);

        private static bool IsInvalidKeyedStateError(InvalidOperationException exception) =>
            IsDuplicateKeyError(exception)
            || string.Equals(exception.Message, UnassignedBaselineErrorMessage, StringComparison.Ordinal)
            || string.Equals(exception.Message, UnassignedChangeSetBaselineErrorMessage, StringComparison.Ordinal);

        private void RevertFromInvalidKeyedState(InvalidOperationException exception)
        {
            if (_writeModel is null || _baselineToModel is null || !_baseline.IsPresent || _baseline.Value is null) {
                throw new InvalidOperationException(
                    "The live model cannot be diffed because its keyed state is invalid, "
                        + "and this session cannot materialize its baseline for recovery.",
                    exception
                );
            }
            _writeModel(_model, _baselineToModel(_baseline.Value));
            RefreshAfterModelMutation();
        }

        private TModel CloneLiveModel(TModel source)
        {
            if (_baselineToModel is null) throw new NotSupportedException("This edit session cannot copy its model because it was built without baseline materialization support.");
            return _baselineToModel(_fromModel(source));
        }

        private void OnPropertyChanged(string propertyName)
        {
            if (_batchDepth > 0) {
                _batchPropertyChanged = true;
                return;
            }
            PropertyChanged?.Invoke(this, new PropertyChangedEventArgs(propertyName));
        }

        private static void ValidateNotificationDelegates(Func<TModel, TFragment> fromModel, Func<__OPTIONAL_TYPE__<TFragment?>, __OPTIONAL_TYPE__<TFragment?>, TChangeSet> between, Func<TChangeSet, TPatch> toPatch, Func<TChangeSet, bool> isEmpty, Func<TChangeSet, __OPTIONAL_TYPE__<TFragment?>, __OPTIONAL_TYPE__<TFragment?>> advanceBaseline, Func<TModel, Action?, TObservable> toObservable)
        {
            if (fromModel is null) throw new ArgumentNullException(nameof(fromModel));
            if (between is null) throw new ArgumentNullException(nameof(between));
            if (toPatch is null) throw new ArgumentNullException(nameof(toPatch));
            if (isEmpty is null) throw new ArgumentNullException(nameof(isEmpty));
            if (advanceBaseline is null) throw new ArgumentNullException(nameof(advanceBaseline));
            if (toObservable is null) throw new ArgumentNullException(nameof(toObservable));
        }

        private static void ValidateDelegates(Func<TModel, TFragment> fromModel, Func<__OPTIONAL_TYPE__<TFragment?>, __OPTIONAL_TYPE__<TFragment?>, TChangeSet> between, Func<TChangeSet, TPatch> toPatch, Func<TChangeSet, bool> isEmpty, Func<TChangeSet, __OPTIONAL_TYPE__<TFragment?>, __OPTIONAL_TYPE__<TFragment?>> advanceBaseline, Func<TModel, TObservable> toObservable)
        {
            if (fromModel is null) throw new ArgumentNullException(nameof(fromModel));
            if (between is null) throw new ArgumentNullException(nameof(between));
            if (toPatch is null) throw new ArgumentNullException(nameof(toPatch));
            if (isEmpty is null) throw new ArgumentNullException(nameof(isEmpty));
            if (advanceBaseline is null) throw new ArgumentNullException(nameof(advanceBaseline));
            if (toObservable is null) throw new ArgumentNullException(nameof(toObservable));
        }
    }
}
