<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net6.0;net10.0</TargetFrameworks>
    <AssemblyName>SparseTypes.Fragments</AssemblyName>
    <RootNamespace>SparseTypes</RootNamespace>
    <IsPackable>true</IsPackable>
    <PackageDescription>SparseTypes subset for typed partial state management in C#.</PackageDescription>
    <PackageTags>dotnet;source-generator;fragment;patch</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../SparseTypes.Core/SparseTypes.Core.csproj" />
    <ProjectReference
      Include="../SparseTypes.Fragments.Generator/SparseTypes.Fragments.Generator.csproj"
      OutputItemType="Analyzer"
      ReferenceOutputAssembly="false"
    />
  </ItemGroup>
  <ItemGroup>
    <None
      Include="../SparseTypes.Fragments.Generator/bin/$(Configuration)/netstandard2.0/SparseTypes.Fragments.Generator.dll"
      Pack="true"
      PackagePath="analyzers/dotnet/cs"
      Visible="false"
    />
    <None
      Include="../SparseTypes.Fragments.Generator/build/SparseTypes.Fragments.props"
      Pack="true"
      PackagePath="build/SparseTypes.Fragments.props"
      Visible="false"
    />
    <None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
