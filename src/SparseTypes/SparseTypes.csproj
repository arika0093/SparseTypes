<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <AssemblyName>SparseTypes</AssemblyName>
    <RootNamespace>SparseTypes</RootNamespace>
    <IsPackable>true</IsPackable>
    <PackageDescription>A unified change model for .NET.</PackageDescription>
    <PackageTags>dotnet;source-generator;patch;merge;nativeaot</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="System.Memory" Version="4.6.3" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../SparseTypes.Core/SparseTypes.Core.csproj" />
    <ProjectReference Include="../SparseTypes.Generator/SparseTypes.Generator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>
  <ItemGroup>
    <None
      Include="../SparseTypes.Generator/bin/$(Configuration)/netstandard2.0/SparseTypes.Generator.dll"
      Pack="true"
      PackagePath="analyzers/dotnet/cs"
      Visible="false"
    />
    <None Include="../SparseTypes.Generator/build/SparseTypes.props" Pack="true" PackagePath="build/SparseTypes.props" Visible="false" />
    <None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
