<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>SparseTypes.OpenApi.AspNetCore</AssemblyName>
    <RootNamespace>SparseTypes.OpenApi.AspNetCore</RootNamespace>
    <IsPackable>true</IsPackable>
    <PackageDescription>ASP.NET Core OpenAPI support for SparseTypes ChangePayload schemas.</PackageDescription>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>dotnet;openapi;aspnetcore;patch;sparsetypes</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.14" />
    <ProjectReference Include="../SparseTypes/SparseTypes.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
