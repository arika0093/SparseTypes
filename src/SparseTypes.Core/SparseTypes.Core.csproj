<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <AssemblyName>SparseTypes.Core</AssemblyName>
    <RootNamespace>SparseTypes</RootNamespace>
    <IsPackable>true</IsPackable>
    <PackageDescription>Core value and attribute contracts shared by SparseTypes packages.</PackageDescription>
    <PackageTags>dotnet;source-generator;patch;core</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="System.Memory" Version="4.6.3" />
  </ItemGroup>
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
