<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>SparseTypes.OpenApi.Swashbuckle</AssemblyName>
    <RootNamespace>SparseTypes.OpenApi.Swashbuckle</RootNamespace>
    <IsPackable>true</IsPackable>
    <PackageDescription>Swashbuckle support for SparseTypes ChangePayload schemas.</PackageDescription>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>dotnet;openapi;swashbuckle;patch;sparsetypes</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Swashbuckle.AspNetCore.SwaggerGen" Version="10.3.0" />
    <ProjectReference Include="../SparseTypes/SparseTypes.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="../SparseTypes.OpenApi.AspNetCore/Internal/SparseOpenApiSchemaParser.cs" Link="Internal/SparseOpenApiSchemaParser.cs" />
  </ItemGroup>
</Project>
