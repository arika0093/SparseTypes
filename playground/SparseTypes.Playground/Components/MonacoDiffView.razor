@using BlazorMonaco.Editor
@using Microsoft.JSInterop
@using SparseTypes.Playground.Models
@inject MonacoThemeCoordinator ThemeCoordinator
@inject IJSRuntime JS
@implements IAsyncDisposable
@implements IDisposable

<div class="pg-monaco notranslate" translate="no" style="@WrapperStyle">
    @if (_loadError is not null) {
        <div class="pg-monaco-loading" role="alert">The diff viewer could not load: @_loadError</div>
    } else if (!_ready) {
        <div class="pg-monaco-loading" role="status">Loading diff viewer…</div>
    } else {
        <StandaloneDiffEditor @ref="_editor"
            Id="@EditorId"
            ConstructionOptions="GetOptions"
            OnDidInit="HandleInit"
            CssClass="pg-monaco-editor" />
    }
</div>

@code {
    private StandaloneDiffEditor? _editor;
    private TextModel? _originalModel;
    private TextModel? _modifiedModel;
    private string? _lastOriginal;
    private string? _lastModified;
    private bool _initialized;
    private bool _ready;
    private string? _loadError;
    private bool _disposed;

    [Parameter, EditorRequired]
    public string Original { get; set; } = string.Empty;

    [Parameter, EditorRequired]
    public string Modified { get; set; } = string.Empty;

    [Parameter]
    public string Language { get; set; } = "json";

    [Parameter]
    public string Height { get; set; } = "300px";

    /// <summary>Gets or sets whether the editor fills the available card height.</summary>
    [Parameter]
    public bool Fill { get; set; }

    private string EditorId { get; } = $"monaco-diff-{Guid.NewGuid():N}";

    private string CurrentTheme => ThemeCoordinator.CurrentTheme;

    private string MonacoLanguage => Language == "csharp" ? "playground-csharp" : Language;

    private string WrapperStyle => Fill ? "height: 100%; min-height: 220px;" : $"height: {Height};";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Blazor can render before Monaco's asynchronous module execution
        // finishes; creating the editor earlier fails permanently.
        if (firstRender)
        {
            _loadError = await MonacoReadiness.WaitForMonacoAsync(JS);
            if (!_disposed)
            {
                _ready = _loadError is null;
                StateHasChanged();
            }
        }

        await base.OnAfterRenderAsync(firstRender);
    }

    private StandaloneDiffEditorConstructionOptions GetOptions(StandaloneDiffEditor editor)
    {
        return new StandaloneDiffEditorConstructionOptions
        {
            AutomaticLayout = true,
            ReadOnly = true,
            Theme = CurrentTheme,
            Minimap = new EditorMinimapOptions { Enabled = false },
            StickyScroll = new EditorStickyScrollOptions { Enabled = false },
            RenderSideBySide = true,
            UseInlineViewWhenSpaceIsLimited = false,
        };
    }

    private async Task HandleInit()
    {
        if (_editor is null || _disposed)
        {
            return;
        }

        try
        {
            _originalModel = await Global.CreateModel(JS, Original, MonacoLanguage);
            if (await ReleaseIfAbandonedAsync())
            {
                return;
            }

            _modifiedModel = await Global.CreateModel(JS, Modified, MonacoLanguage);
            if (await ReleaseIfAbandonedAsync())
            {
                return;
            }

            var editor = _editor;
            if (editor is null || _disposed || _originalModel is null || _modifiedModel is null)
            {
                await DetachAndDisposeOwnedModelsAsync(tolerateDisconnect: true);
                return;
            }

            await editor.SetModel(
                new DiffEditorModel { Original = _originalModel, Modified = _modifiedModel });
            if (_disposed)
            {
                await DetachAndDisposeOwnedModelsAsync(tolerateDisconnect: true);
                return;
            }

            _lastOriginal = Original;
            _lastModified = Modified;
            _initialized = true;
            ThemeCoordinator.NotifyEditorReady();
        }
        catch (Exception exception) when (_disposed && IsTeardownNoise(exception))
        {
            // Navigation already tore the owner down; drop partial models
            // without faulting the teardown batch.
            await DetachAndDisposeOwnedModelsAsync(tolerateDisconnect: true);
        }
        catch
        {
            // The second model or the attach failed: never orphan the first.
            await DetachAndDisposeOwnedModelsAsync(tolerateDisconnect: false);
            throw;
        }
    }

    // Navigation won while a model was being created: release whatever
    // arrived instead of assigning it to an abandoned component.
    private async Task<bool> ReleaseIfAbandonedAsync()
    {
        if (!_disposed && _editor is not null)
        {
            return false;
        }

        await DetachAndDisposeOwnedModelsAsync(tolerateDisconnect: true);
        return true;
    }

    // Detaches the owned models from a live diff editor, then releases both
    // exactly once; consumed fields make repeat calls (Dispose plus
    // DisposeAsync, init-race tails) no-ops. Detaching first matters because
    // Monaco reports disposing an attached model as an error.
    private async Task DetachAndDisposeOwnedModelsAsync(bool tolerateDisconnect)
    {
        var editorId = _editor is null ? null : EditorId;
        _editor = null;
        var original = _originalModel;
        var modified = _modifiedModel;
        _originalModel = null;
        _modifiedModel = null;
        _initialized = false;
        _lastOriginal = null;
        _lastModified = null;

        if (editorId is not null && (original is not null || modified is not null))
        {
            try
            {
                await JS.InvokeVoidAsync("pgMonaco.detachDiff", editorId);
            }
            catch (Exception exception) when (IsTeardownNoise(exception))
            {
                // The editor (or circuit) is already gone; disposing below
                // is still safe because nothing references the models.
            }
        }

        if (tolerateDisconnect)
        {
            await DisposeModelBestEffortAsync(original);
            await DisposeModelBestEffortAsync(modified);
        }
        else
        {
            if (original is not null)
            {
                await original.DisposeModel();
            }

            if (modified is not null)
            {
                await modified.DisposeModel();
            }
        }
    }

    private static async Task DisposeModelBestEffortAsync(TextModel? model)
    {
        if (model is null)
        {
            return;
        }

        try
        {
            await model.DisposeModel();
        }
        catch (Exception exception) when (IsTeardownNoise(exception))
        {
            // The page or circuit already went away with the models.
        }
    }

    // Failures that only mean the JS side (or the renderer) is already gone.
    private static bool IsTeardownNoise(Exception exception) =>
        exception is JSDisconnectedException
            or JSException
            or ObjectDisposedException
            or TaskCanceledException
            or InvalidOperationException;

    protected override async Task OnParametersSetAsync()
    {
        await SyncAsync();
    }

    private async Task SyncAsync()
    {
        if (_disposed || !_initialized || _originalModel is null || _modifiedModel is null)
        {
            return;
        }

        var originalModel = _originalModel;
        var modifiedModel = _modifiedModel;

        try
        {
            if (_lastOriginal != Original)
            {
                _lastOriginal = Original;
                await originalModel.SetValue(Original);
                if (
                    _disposed
                    || !ReferenceEquals(_originalModel, originalModel)
                    || !ReferenceEquals(_modifiedModel, modifiedModel)
                )
                {
                    return;
                }
            }
            if (_lastModified != Modified)
            {
                _lastModified = Modified;
                await modifiedModel.SetValue(Modified);
                if (
                    _disposed
                    || !ReferenceEquals(_originalModel, originalModel)
                    || !ReferenceEquals(_modifiedModel, modifiedModel)
                )
                {
                    return;
                }
            }
        }
        catch (Exception exception) when (_disposed && IsTeardownNoise(exception))
        {
            // Navigation raced an in-flight update after cleanup.
        }
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        await DetachAndDisposeOwnedModelsAsync(tolerateDisconnect: true);
    }

    public void Dispose()
    {
        _disposed = true;
    }
}
