@using BlazorMonaco.Editor
@using SparseTypes.Playground.Models
@inject IJSRuntime JS
@inject MonacoThemeCoordinator ThemeCoordinator
@implements IDisposable

@if (_loadError is not null) {
    <div class="pg-monaco notranslate" translate="no" style="@WrapperStyle">
        <div class="pg-monaco-loading" role="alert">The code editor could not load: @_loadError</div>
    </div>
} else if (!_ready) {
    <div class="pg-monaco notranslate" translate="no" style="@WrapperStyle">
        <div class="pg-monaco-loading" role="status">Loading code editor…</div>
    </div>
} else {
    <div class="pg-monaco notranslate" translate="no" style="@WrapperStyle">
        <StandaloneCodeEditor @ref="_editor"
            Id="@EditorId"
            ConstructionOptions="GetOptions"
            OnDidInit="HandleInit"
            OnDidChangeModelContent="HandleContentChanged"
            CssClass="pg-monaco-editor" />
    </div>
}

@code {
    private StandaloneCodeEditor? _editor;
    private string? _lastValue;
    private bool _initialized;
    private bool _ready;
    private string? _loadError;
    private bool _disposed;

    [Parameter]
    public string Value { get; set; } = string.Empty;

    [Parameter]
    public EventCallback<string> ValueChanged { get; set; }

    [Parameter]
    public string Language { get; set; } = "json";

    [Parameter]
    public string Height { get; set; } = "360px";

    [Parameter]
    public bool ReadOnly { get; set; }

    /// <summary>Gets or sets whether the editor fills the available card height.</summary>
    [Parameter]
    public bool Fill { get; set; }

    private string EditorId { get; } = $"monaco-edit-{Guid.NewGuid():N}";

    private string CurrentTheme => ThemeCoordinator.CurrentTheme;

    private string MonacoLanguage => Language == "csharp" ? "playground-csharp" : Language;

    private string WrapperStyle => Fill ? "height: 100%; min-height: 220px;" : $"height: {Height};";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Blazor can render before Monaco's asynchronous module execution
        // finishes; creating the editor earlier fails permanently.
        if (firstRender)
        {
            _loadError = await MonacoReadiness.WaitForMonacoAsync(JS);
            if (!_disposed)
            {
                _ready = _loadError is null;
                StateHasChanged();
            }
        }

        await base.OnAfterRenderAsync(firstRender);
    }

    private StandaloneEditorConstructionOptions GetOptions(StandaloneCodeEditor editor)
    {
        _lastValue = Value;
        return new StandaloneEditorConstructionOptions
        {
            AutomaticLayout = true,
            Language = MonacoLanguage,
            Value = Value,
            ReadOnly = ReadOnly,
            Minimap = new EditorMinimapOptions { Enabled = false },
            Scrollbar = new EditorScrollbarOptions { Vertical = "auto", Horizontal = "auto" },
            StickyScroll = new EditorStickyScrollOptions { Enabled = false },
            ScrollBeyondLastLine = false,
            RenderLineHighlight = "all",
            Theme = CurrentTheme,
        };
    }

    private async Task HandleInit()
    {
        _initialized = true;
        ThemeCoordinator.NotifyEditorReady();
        await SyncValueAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        await SyncValueAsync();
    }

    private async Task HandleContentChanged(ModelContentChangedEvent _)
    {
        if (!_initialized || _editor is null)
        {
            return;
        }

        var newValue = await _editor.GetValue();
        _lastValue = newValue;
        if (!string.Equals(newValue, Value, StringComparison.Ordinal))
        {
            await ValueChanged.InvokeAsync(newValue);
        }
    }

    private async Task SyncValueAsync()
    {
        if (!_initialized || _editor is null)
        {
            return;
        }
        if (_lastValue == Value)
        {
            return;
        }
        _lastValue = Value;
        await _editor.SetValue(Value);
    }

    public void Dispose()
    {
        _disposed = true;
    }
}
