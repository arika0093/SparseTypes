@page "/enterprise-editing"
@using SparseTypes.Playground.Components

<PageTitle>Enterprise master editing — SparseTypes Playground</PageTitle>

<section class="pg-section">
    <div class="pg-section-heading">
        <h2>Enterprise master editing with child sessions</h2>
        <GitHubLink Href="https://github.com/arika0093/SparseTypes/tree/main/playground/SparseTypes.Playground/Pages/Case6" Label="Enterprise source on GitHub" />
    </div>
    <FluentTabs Orientation="Orientation.Horizontal" Class="pg-section-tabs-inline">
        <FluentTab Header="Playground" Id="section-enterprise-playground">
            <div class="pg-section-content">
                <p class="pg-hint">Edit a multi-section catalog with independent child sessions, nested lists, and reorderable workflow steps. Enable section drafts to save each scope separately; turn the option off to apply edits directly to the catalog. Work-master tabs update after the Workflow section is applied.</p>
                <EnterpriseCatalogPlayground />
            </div>
        </FluentTab>
        <FluentTab Header="Codes" Id="section-enterprise-codes">
            <CodeSamples />
        </FluentTab>
    </FluentTabs>
</section>

<CasePager PrevHref="concurrent-editing" PrevLabel="Concurrent editing" NextHref="/" NextLabel="Overview" />
