@page "/concurrent-editing"
@using SparseTypes.Playground.Components

<PageTitle>Concurrent editing — SparseTypes Playground</PageTitle>

<section class="pg-section">
    <div class="pg-section-heading">
        <h2>Concurrent editing: simulate another user</h2>
        <GitHubLink Href="https://github.com/arika0093/SparseTypes/tree/main/playground/SparseTypes.Playground/Pages/Concurrency" Label="Concurrent editing source on GitHub" />
    </div>
    <FluentTabs Orientation="Orientation.Horizontal" Class="pg-section-tabs-inline">
        <FluentTab Header="Playground" Id="section-concurrent-playground">
            <div class="pg-section-content">
                <p class="pg-hint">Edit Customer or Notes, submit a snapshot, optionally wait 10 seconds and keep editing during the delay, then re-fetch the in-memory entity without losing newer draft edits.</p>
                <ConcurrencyPlayground />
            </div>
        </FluentTab>
        <FluentTab Header="Codes" Id="section-concurrent-codes">
            <CodeSamples />
        </FluentTab>
    </FluentTabs>
</section>

<CasePager PrevHref="ef-mapping" PrevLabel="EF Core mapping" NextHref="enterprise-editing" NextLabel="Enterprise editing" />
