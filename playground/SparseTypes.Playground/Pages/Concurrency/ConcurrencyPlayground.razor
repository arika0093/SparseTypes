@using Microsoft.EntityFrameworkCore
@using SparseTypes
@using SparseTypes.Blazor
@using SparseTypes.EntityFrameworkCore
@using SparseTypes.Playground.Models
@using SparseTypes.Playground.Components
@using Case5 = SparseTypes.Playground.Pages.Case5
@implements IAsyncDisposable

<div class="pg-stack">
    <div class="pg-grid pg-grid-duo">
        <FluentCard Class="pg-fluent-card">
            <div class="pg-card-head">
                <h3>1. Entity (tracked)</h3>
                <FluentButton Appearance="ButtonAppearance.Primary" Disabled="@IsSaveApplying" @onclick="Reset">Reseed</FluentButton>
            </div>
            <MonacoView Content="@EntityJson" Language="json" Height="270px" />
        </FluentCard>
        <FluentCard Class="pg-fluent-card">
            <div class="pg-card-head">
                <h3>2. DTO projection</h3>
            </div>
            <MonacoView Content="@BaselineJson" Language="json" Height="270px" />
        </FluentCard>
    </div>
    <div class="pg-grid pg-grid-duo">
        <FluentCard Class="pg-fluent-card">
            <div class="pg-card-head">
                <h3>3. Edit draft</h3>
                <div class="pg-actions">
                    <FluentButton Appearance="ButtonAppearance.Default" Disabled="@(IsSaveApplying || _saveBlocked)" @onclick="ResetDraft">Reset draft</FluentButton>
                    <FluentButton Appearance="ButtonAppearance.Primary" Class="pg-submit-button"
                        Disabled="@(_saveBlocked || _savePending || IsSaveApplying || _changes?.IsChanged != true)" @onclick="OpenSaveDialog">Save</FluentButton>
                </div>
            </div>
            <SparseEdit Session="_session" Context="edit">
            <div class="pg-stack pg-edit-fields">
                <SparseField Path="edit.Path.Customer" Context="customer">
                    <div class="pg-row pg-session-field @(customer.IsChanged ? "pg-changed" : "")">
                        <span class="pg-name notranslate" translate="no">@ChangedDot(customer.IsChanged)Customer <small>string</small></span>
                        <div class="pg-case5-field-control">
                            <FluentTextInput Value="@customer.Value" Immediate="true" Disabled="@IsSaveApplying"
                                ValueChanged="@(v => EditFieldAsync(customer, v))" />
                            @if (_serverCustomerUpdated)
                            {
                                <small class="pg-case5-update-notice pg-case5-server-update-notice" aria-live="polite">
                                    Updated from server value
                                </small>
                            }
                            else if (_latestCustomerUpdate is { } customerUpdate)
                            {
                                <small class="pg-case5-update-notice" aria-live="polite">
                                    Updated to @ConcurrencyJson.FormatValue(customerUpdate.After)
                                </small>
                            }
                        </div>
                    </div>
                </SparseField>
                <SparseField Path="edit.Path.Notes" Context="notes">
                    <div class="pg-row pg-session-field @(notes.IsChanged ? "pg-changed" : "")">
                        <span class="pg-name notranslate" translate="no">@ChangedDot(notes.IsChanged)Notes <small>string</small></span>
                        <div class="pg-case5-field-control">
                            <FluentTextInput Value="@notes.Value" Immediate="true" Disabled="@IsSaveApplying"
                                ValueChanged="@(v => EditFieldAsync(notes, v))" />
                            @if (_serverNotesUpdated)
                            {
                                <small class="pg-case5-update-notice pg-case5-server-update-notice" aria-live="polite">
                                    Updated from server value
                                </small>
                            }
                            else if (_latestNotesUpdate is { } notesUpdate)
                            {
                                <small class="pg-case5-update-notice" aria-live="polite">
                                    Updated to @ConcurrencyJson.FormatValue(notesUpdate.After)
                                </small>
                            }
                        </div>
                    </div>
                </SparseField>
            </div>
            </SparseEdit>
            <MonacoView Content="@DraftJson" Language="json" Height="200px" />
            <div class="pg-case5-rebase-options">
                <FluentCheckbox Value="@_waitBeforeApply"
                    ValueChanged="@(value => _waitBeforeApply = value)" Disabled="@_savePending">
                    Wait 10 seconds before applying save
                </FluentCheckbox>
                <FluentCheckbox Value="@_simulateConflict"
                    ValueChanged="OnSimulateConflictChanged" Disabled="@_savePending">
                    Simulate another user editing before save
                </FluentCheckbox>
                <div class="pg-case5-rebase-select">
                    <span class="pg-name">Conflict handling</span>
                    <FluentSelect TOption="string" TValue="string"
                        Items="@ConflictHandlingOptions"
                        OptionValue="@(value => value)"
                        OptionText="@(value => value)"
                        Value="@ConflictHandlingName(_conflictHandlingMode)"
                        ValueChanged="OnConflictHandlingChanged"
                        Disabled="@(!_simulateConflict || _savePending)"
                        aria-label="Conflict handling" />
                </div>
                <FluentCheckbox Value="@_periodicSimulationEnabled"
                    ValueChanged="OnPeriodicSimulationChanged"
                    Disabled="@(!_simulateConflict)">
                    Simulate real-time edits every 10 seconds
                </FluentCheckbox>
                <p class="pg-hint">The draft keeps the revision captured with its baseline. Standard rebases against the current persisted DTO and reports overlapping edits; Strict rejects the save if that revision has changed.</p>
                @if (_simulationError is not null)
                {
                    <FluentMessageBar Intent="MessageBarIntent.Error">@_simulationError</FluentMessageBar>
                }
            </div>
        </FluentCard>
        <FluentCard Class="pg-fluent-card">
            <div class="pg-card-head">
                <h3>4. Save Entity</h3>
                <span class="pg-has-changes-badge @(_changes?.IsChanged == true ? "pg-has-changes" : "pg-no-changes")">
                    <span aria-hidden="true"></span>@(_changes?.IsChanged == true ? "Changes" : "No changes")
                </span>
            </div>
            <p class="pg-hint">Saving compares the revision captured with the draft baseline. The simulation increments the persisted revision to demonstrate each conflict handling mode.</p>
            @if (_changesError is not null)
            {
                <FluentMessageBar Intent="MessageBarIntent.Error">@_changesError</FluentMessageBar>
            }
            @if (_applyError is not null)
            {
                <FluentMessageBar Intent="MessageBarIntent.Error">@_applyError</FluentMessageBar>
            }
            @if (_saveError is not null)
            {
                <FluentMessageBar Intent="MessageBarIntent.Error">@_saveError</FluentMessageBar>
            }
            @if (!_applied && _applyError is null)
            {
                @if (_waitBeforeApply)
                {
                    <p class="pg-hint">Confirm a ChangeSet to apply its snapshot after 10 seconds. You can keep editing the draft during the delay.</p>
                }
                else
                {
                    <p class="pg-hint">Confirm a ChangeSet to apply its snapshot immediately.</p>
                }
            }
            @if (_applied)
            {
                @if (_modifiedRows.Count == 0)
                {
                    <p class="pg-hint">No EF Core properties changed.</p>
                }
                else
                {
                    <div class="pg-change-table-wrap pg-case5-results-wrap">
                        <table class="pg-change-table pg-case5-results-table" aria-label="Modified EF properties">
                            <thead>
                                <tr><th>Entity</th><th>Operation</th><th>Property</th><th>Before</th><th>After</th></tr>
                            </thead>
                            <tbody>
                                @foreach (var row in _modifiedRows)
                                {
                                    <tr>
                                        <td><span class="pg-change-value">@row.Entity</span></td>
                                        <td><span class="@PlaygroundPageHelper.ChangeOperationClass(Case5.PlaygroundEfPresentation.EfStateOperation(row.State))">@Case5.PlaygroundEfPresentation.EfStateOperation(row.State)</span></td>
                                        <td><span class="pg-change-value">@row.Property</span></td>
                                        <td><span class="pg-change-value">@row.Before</span></td>
                                        <td><span class="pg-change-value">@row.After</span></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                <MonacoDiffView Original="@_entityJsonBeforeApply" Modified="@_entityJsonAfterApply" Language="json" Height="240px" />
            }
        </FluentCard>
    </div>
</div>

<SaveSnackbar Visible="_savePending" OnApply="ApplyPendingSave" />

<FluentDialog @ref="_saveDialog" Hidden="@_saveDialogHidden" Modal="true" TrapFocus="true"
    Size="@DialogSize.Full" Class="pg-submit-preview-dialog" AriaLabel="Confirm save changes">
    <div class="pg-dialog-heading">
        <h3>Save changes</h3>
    </div>
    <div class="pg-dialog-body">
        @if (_waitBeforeApply)
        {
            <p class="pg-hint">Review the ChangeSet. After confirmation, this snapshot applies in 10 seconds; you can keep editing the draft meanwhile.</p>
        }
        else
        {
            <p class="pg-hint">Review the ChangeSet. After confirmation, this snapshot applies immediately.</p>
        }
        @if (_changeRows.Count == 0)
        {
            <p class="pg-hint">No changes.</p>
        }
        else
        {
            <ChangePreviewTable Rows="_changeRows" TargetHeader="Path" AriaLabel="Order ChangeSet" />
        }
    </div>
    <div class="pg-dialog-footer">
        <FluentButton Appearance="ButtonAppearance.Primary" @onclick="ConfirmSave">Save</FluentButton>
        <FluentButton Appearance="ButtonAppearance.Default" @onclick="CloseSaveDialog">Cancel</FluentButton>
    </div>
</FluentDialog>

<ConflictDialog Visible="_conflictVisible" Summary="@_conflictSummary"
    Conflicts="_conflictRows" CanApplyResolution="@CanApplyResolution" IsApplying="@_resolutionApplying"
    SubmittedHeader="@_conflictSubmittedHeader"
    OnUseSubmitted="UseSubmittedConflictValue" OnUseCurrent="UseCurrentConflictValue"
    OnResolve="ApplyConflictResolution" OnClose="CloseConflictDialog" />

@code {
    private enum ConflictHandlingMode
    {
        Standard,
        Strict,
    }

    private static readonly DbContextOptions<ConcurrentOrderContext> SharedOptions =
        new DbContextOptionsBuilder<ConcurrentOrderContext>()
            .UseInMemoryDatabase("pg-concurrency-demo")
            .Options;
    private readonly SemaphoreSlim _storeGate = new(1, 1);

    private ConcurrentOrderContext? _db;
    private ConcurrentOrderEntity? _tracked;
    private SparseEntityMapper<ConcurrentOrderEntity, ConcurrentOrderDto>? _mapper;
    private SparseEntityApplyResult? _applyResult;
    // Session-owned draft and baseline.
    private ConcurrentOrderDto.EditSession _session = null!;
    private ConcurrentOrderDto _liveDraft = null!;
    private ConcurrentOrderDto _baselineView = new();
    private int _draftBaseRevision;
    private ConcurrentOrderDto.ChangeSet? _changes;
    private string? _changesError;
    private string? _applyError;
    private string? _saveError;
    private bool _applied;
    private bool _savePending;
    private bool _saveApplying;
    private bool _saveBlocked;
    private bool _simulateConflict = true;
    private bool _periodicSimulationEnabled;
    private bool _waitBeforeApply;
    private ConcurrentUpdate? _latestCustomerUpdate;
    private ConcurrentUpdate? _latestNotesUpdate;
    private bool _serverCustomerUpdated;
    private bool _serverNotesUpdated;
    private string? _simulationError;
    private CancellationTokenSource? _simulationCancellation;
    private Task? _simulationTask;
    private CancellationTokenSource? _serverSyncNoticeCancellation;
    private Task? _serverSyncNoticeTask;
    private string _entityJsonBeforeApply = string.Empty;
    private FluentDialog? _saveDialog;
    private bool _saveDialogHidden = true;
    private bool _conflictVisible;
    private string _conflictSummary = string.Empty;
    private IReadOnlyList<ChangePreviewRow> _changeRows = [];
    private List<(string Entity, string State, string Property, string Before, string After)> _modifiedRows = [];
    private string _entityJsonAfterApply = string.Empty;
    private ConcurrencySaveSnapshot? _pendingSaveSnapshot;
    private bool _pendingSimulateConflict;
    private List<(
        SparsePath? Path,
        string PathText,
        string Baseline,
        string Submitted,
        string Current,
        string Kind,
        bool CanResolve,
        bool? UseSubmitted
    )> _conflictRows = [];
    private ConcurrentOrderDto.ChangeSet.Resolution? _conflictResolution;
    private ConcurrentOrderDto.ChangeSet? _resolutionSubmitted;
    private ConcurrentOrderDto? _resolutionSubmittedDraft;
    private int _resolutionExpectedRevision;
    private int _resolutionOrderId;
    private bool _resolutionStale;
    private bool _resolutionApplying;
    private string _conflictSubmittedHeader = "Captured submitted value";
    private ConflictHandlingMode _conflictHandlingMode = ConflictHandlingMode.Standard;
    private ConflictHandlingMode? _pendingConflictHandlingMode;

    private static readonly string[] ConflictHandlingOptions = ["Standard", "Strict"];
    private bool IsSaveApplying => _saveApplying || _resolutionApplying;
    private bool CanApplyResolution =>
        !_saveBlocked
        && _conflictResolution is not null
        && !_resolutionStale
        && !_resolutionApplying
        && _conflictRows.Any(static row => row.CanResolve)
        && _conflictRows.Where(static row => row.CanResolve).All(static row => row.UseSubmitted.HasValue);

    private string EntityJson => _preview.EntityJson;
    private string BaselineJson => _preview.BaselineJson;
    private string DraftJson => _preview.DraftJson;

    // Lazy JSON panes with per-source invalidation: the entity pane refreshes
    // on explicit save/reload events, the baseline pane when a persisted DTO
    // is adopted, and the draft pane on every draft edit.
    private Case5.Case5Preview _preview = null!;

    // The live draft instance owned by the session; the UI mutates it directly.
    private ConcurrentOrderDto _draft => _liveDraft;

    /// <summary>Reseeds the store and resets the whole pipeline. Called by the page too.</summary>
    public async Task Reset()
    {
        if (IsSaveApplying)
        {
            return;
        }

        await StopPeriodicSimulationAsync();
        await StopServerSyncNoticeAsync();
        await _storeGate.WaitAsync();
        try
        {
            _saveDialogHidden = true;
            Seed();
        }
        finally
        {
            _storeGate.Release();
        }
    }

    protected override void OnInitialized() => Seed();

    public async ValueTask DisposeAsync()
    {
        await StopPeriodicSimulationAsync();
        await StopServerSyncNoticeAsync();
        await _storeGate.WaitAsync();
        try
        {
            _db?.Dispose();
            _db = null;
        }
        finally
        {
            _storeGate.Release();
            _storeGate.Dispose();
        }
    }

    private async Task OnPeriodicSimulationChanged(bool enabled)
    {
        if (enabled && !_simulateConflict)
        {
            _periodicSimulationEnabled = false;
            return;
        }

        _periodicSimulationEnabled = enabled;
        _simulationError = null;
        if (enabled)
        {
            StartPeriodicSimulation();
        }
        else
        {
            await StopPeriodicSimulationAsync();
        }
    }

    private async Task OnSimulateConflictChanged(bool enabled)
    {
        _simulateConflict = enabled;
        if (!enabled && _periodicSimulationEnabled)
        {
            _periodicSimulationEnabled = false;
            await StopPeriodicSimulationAsync();
        }
    }

    private void StartPeriodicSimulation()
    {
        if (_simulationTask is { IsCompleted: false })
        {
            return;
        }

        _simulationCancellation?.Dispose();
        var cancellation = new CancellationTokenSource();
        _simulationCancellation = cancellation;
        _simulationTask = RunPeriodicSimulationAsync(cancellation.Token);
    }

    private async Task StopPeriodicSimulationAsync()
    {
        var cancellation = _simulationCancellation;
        var task = _simulationTask;
        _simulationCancellation = null;
        _simulationTask = null;
        if (cancellation is null)
        {
            return;
        }

        cancellation.Cancel();
        if (task is not null)
        {
            await task;
        }

        cancellation.Dispose();
    }

    private async Task ShowServerSyncNoticeAsync(bool customerUpdated, bool notesUpdated)
    {
        await StopServerSyncNoticeAsync();
        _serverCustomerUpdated = customerUpdated;
        _serverNotesUpdated = notesUpdated;
        if (!customerUpdated && !notesUpdated)
        {
            return;
        }

        var cancellation = new CancellationTokenSource();
        _serverSyncNoticeCancellation = cancellation;
        _serverSyncNoticeTask = ClearServerSyncNoticeAsync(cancellation.Token);
    }

    private async Task StopServerSyncNoticeAsync()
    {
        var cancellation = _serverSyncNoticeCancellation;
        var task = _serverSyncNoticeTask;
        _serverSyncNoticeCancellation = null;
        _serverSyncNoticeTask = null;
        if (cancellation is null)
        {
            return;
        }

        cancellation.Cancel();
        try
        {
            if (task is not null)
            {
                await task;
            }
        }
        finally
        {
            cancellation.Dispose();
        }
    }

    private async Task ClearServerSyncNoticeAsync(CancellationToken cancellationToken)
    {
        try
        {
            await Task.Delay(TimeSpan.FromSeconds(5), cancellationToken);
            await InvokeAsync(() =>
            {
                if (cancellationToken.IsCancellationRequested)
                {
                    return;
                }

                _serverCustomerUpdated = false;
                _serverNotesUpdated = false;
                StateHasChanged();
            });
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested) { }
    }

    private async Task RunPeriodicSimulationAsync(CancellationToken cancellationToken)
    {
        try
        {
            while (true)
            {
                await Task.Delay(TimeSpan.FromSeconds(10), cancellationToken);
                await _storeGate.WaitAsync(cancellationToken);
                ConcurrentUpdate update;
                try
                {
                    if (_tracked is null || _db is null)
                    {
                        throw new InvalidOperationException("The EF Core demo store is not initialized.");
                    }

                    var orderId = _tracked.Id;
                    update = ConcurrencySimulation.SimulatePeriodicUpdate(SharedOptions, orderId);
                    _db.ChangeTracker.Clear();
                    _tracked = _db.Orders
                        .Include(static order => order.Note)
                        .Single(order => order.Id == orderId);
                    _preview.InvalidateEntity();
                }
                finally
                {
                    _storeGate.Release();
                }

                await InvokeAsync(() =>
                {
                    if (update.Property == "Customer")
                    {
                        _latestCustomerUpdate = update;
                    }
                    else if (update.Property == "Notes")
                    {
                        _latestNotesUpdate = update;
                    }
                    StateHasChanged();
                });
            }
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested) { }
        catch (Exception ex)
        {
            await InvokeAsync(() =>
            {
                _simulationError = $"Periodic update failed: {ex.GetType().Name}: {ex.Message}";
                _periodicSimulationEnabled = false;
                StateHasChanged();
            });
        }
    }

    private void Seed()
    {
        _savePending = false;
        _saveApplying = false;
        _saveBlocked = false;
        _pendingSaveSnapshot = null;
        _pendingConflictHandlingMode = null;
        _pendingSimulateConflict = false;
        _entityJsonAfterApply = string.Empty;
        _db?.Dispose();
        _db = new ConcurrentOrderContext(SharedOptions);
        _db.Database.EnsureDeleted();
        _db.Database.EnsureCreated();
        var seeded = _db.Orders.Add(
            new ConcurrentOrderEntity
            {
                CustomerName = "Cafe Vienna",
                Note = new ConcurrentNoteEntity { Text = "first order" },
            }
        ).Entity;
        _db.SaveChanges();
        _tracked = seeded;
        _mapper = ConcurrentOrderMapper.Create(_db.Model);
        _draftBaseRevision = seeded.Revision;
        var initial = _mapper.ToDto(_tracked);
        _liveDraft = initial;
        _session = initial.CreateEditSession();
        _baselineView = initial.DeepClone();
        _preview = new Case5.Case5Preview(
            () => Case5.PlaygroundEfPresentation.Try(() => _tracked is null ? "{}" : ConcurrencyJson.WriteEntity(_tracked)),
            () => Case5.PlaygroundEfPresentation.Try(() => ConcurrencyJson.WriteDto(_baselineView)),
            () => Case5.PlaygroundEfPresentation.Try(() => ConcurrencyJson.WriteDto(_draft))
        );
        _applied = false;
        _applyResult = null;
        _simulateConflict = true;
        _periodicSimulationEnabled = false;
        _waitBeforeApply = false;
        _latestCustomerUpdate = null;
        _latestNotesUpdate = null;
        _serverCustomerUpdated = false;
        _serverNotesUpdated = false;
        _simulationError = null;
        _conflictHandlingMode = ConflictHandlingMode.Standard;
        _modifiedRows = [];
        _saveDialogHidden = true;
        _conflictVisible = false;
        _conflictRows = [];
        ClearConflictResolution();
        RefreshChanges();
    }

    private void ResetDraft()
    {
        if (IsSaveApplying || _saveBlocked)
        {
            return;
        }

        // A pending submission references the retained baseline, so cancel it
        // first: reverting would otherwise orphan the in-flight snapshot.
        _savePending = false;
        _pendingSaveSnapshot = null;
        _pendingConflictHandlingMode = null;
        _pendingSimulateConflict = false;
        try
        {
            _session.RevertChanges();
        }
        catch (InvalidOperationException)
        {
            RefreshChanges();
            _changesError = "The pending changes cannot be reverted in place; reseed to recover.";
            return;
        }

        _applied = false;
        _applyResult = null;
        _modifiedRows = [];
        RefreshChanges();
    }

    // Field writes arrive through SparseField bindings (which own the session
    // write and refresh).
    private void OnDraftEdited()
    {
        _applied = false;
        _applyResult = null;
        _modifiedRows = [];
        RefreshChanges();
    }

    // Scalar writes through one shared adapter: the field owns the session
    // write, and the draft bookkeeping above follows it.
    private async Task EditFieldAsync<TValue>(SparseFieldContext<ConcurrentOrderDto, TValue> field, TValue? value)
    {
        if (IsSaveApplying)
        {
            return;
        }

        await field.SetAsync(value);
        OnDraftEdited();
    }

    private static RenderFragment ChangedDot(bool changed) => builder =>
    {
        if (changed)
        {
            builder.OpenElement(0, "span");
            builder.AddAttribute(1, "class", "pg-dot");
            builder.AddAttribute(2, "title", "edited");
            builder.CloseElement();
        }
    };

    // Scalar highlights now come from each SparseField's render-scoped state.
    private static string ConflictHandlingName(ConflictHandlingMode mode) => mode switch
    {
        ConflictHandlingMode.Standard => "Standard",
        ConflictHandlingMode.Strict => "Strict",
        _ => throw new ArgumentOutOfRangeException(nameof(mode), mode, null),
    };

    private void OnConflictHandlingChanged(string? value)
    {
        _conflictHandlingMode = value switch
        {
            "Standard" => ConflictHandlingMode.Standard,
            "Strict" => ConflictHandlingMode.Strict,
            _ => throw new ArgumentOutOfRangeException(nameof(value), value, null),
        };
    }

    private void RefreshChanges()
    {
        _changesError = null;
        _applyError = null;
        _saveError = null;
        _preview.InvalidateDraft();
        try
        {
            _changes = _session.CreateChangeSet();
            _changeRows = SparseChangeRowProjection.Project(
                _changes,
                new SparseChangeRowOptions
                {
                    FormatOperation = PlaygroundPageHelper.ChangeOperation,
                    FormatValue = static value => ConcurrencyJson.FormatValue(value),
                }
            )
                .Select(static row => new ChangePreviewRow
                {
                    Target = row.PathText,
                    Operation = row.Operation,
                    Before = row.BeforeText,
                    After = row.AfterText,
                })
                .ToArray();
        }
        catch (Exception ex)
        {
            _changes = null;
            _changeRows = [];
            _changesError = $"{ex.GetType().Name}: {ex.Message}";
        }
    }

    private async Task OpenSaveDialog()
    {
        if (_saveBlocked || _savePending || IsSaveApplying)
        {
            return;
        }

        _saveDialogHidden = false;
        if (_saveDialog is null)
        {
            throw new InvalidOperationException("The save dialog is not initialized.");
        }

        await _saveDialog.ShowAsync();
    }

    private async Task CloseSaveDialog()
    {
        _saveDialogHidden = true;
        if (_saveDialog is null)
        {
            throw new InvalidOperationException("The save dialog is not initialized.");
        }

        await _saveDialog.HideAsync();
    }

    private async Task ConfirmSave()
    {
        if (_saveBlocked || _savePending || IsSaveApplying)
        {
            return;
        }

        // Capture the exact immutable submission before the awaited save.
        var snapshot = ConcurrencySaveSnapshot.Capture(
            _session,
            _liveDraft,
            _draftBaseRevision
        );
        if (snapshot.Submitted.IsChanged != true)
        {
            await CloseSaveDialog();
            return;
        }

        _pendingSaveSnapshot = snapshot;
        _pendingConflictHandlingMode = _conflictHandlingMode;
        _pendingSimulateConflict = _simulateConflict;
        var waitBeforeApply = _waitBeforeApply;
        await CloseSaveDialog();
        _savePending = true;
        _applied = false;
        _applyResult = null;
        _modifiedRows = [];
        RefreshChanges();
        if (!waitBeforeApply)
        {
            await ApplyPendingSave();
        }
    }

    private async Task ApplyPendingSave()
    {
        if (!_savePending || _pendingSaveSnapshot is null || _pendingConflictHandlingMode is null)
        {
            return;
        }

        var snapshot = _pendingSaveSnapshot;
        var submittedDraftAfterSubmit = _liveDraft.DeepClone();
        var conflictHandlingMode = _pendingConflictHandlingMode.Value;
        var simulateConflict = _pendingSimulateConflict;
        _saveApplying = true;
        _pendingSaveSnapshot = null;
        _pendingConflictHandlingMode = null;
        _pendingSimulateConflict = false;
        await _storeGate.WaitAsync();
        try
        {
            await SaveEntity(
                snapshot,
                submittedDraftAfterSubmit,
                simulateConflict,
                conflictHandlingMode);
        }
        finally
        {
            _storeGate.Release();
            _saveApplying = false;
            _savePending = false;
        }
    }

    private async Task SaveEntity(
        ConcurrencySaveSnapshot snapshot,
        ConcurrentOrderDto submittedDraftAfterSubmit,
        bool simulateConflict,
        ConflictHandlingMode conflictHandlingMode
    )
    {
        _saveError = null;
        var expectedRevision = snapshot.BaseRevision;
        var orderId = _tracked?.Id ?? 0;
        if (_db is null || _tracked is null || _mapper is null)
        {
            throw new InvalidOperationException("The EF Core demo store is not initialized.");
        }

        if (simulateConflict)
        {
            ConcurrencySimulation.SimulateConcurrentEdit(SharedOptions, orderId);
        }

        _entityJsonBeforeApply = EntityJson;
        var localCustomerBeforeSync = _liveDraft.Customer;
        var localNotesBeforeSync = _liveDraft.Notes;
        try
        {
            var outcome = await _mapper.PipelineExecuteAsync(
                _db,
                snapshot.Submitted,
                order => order.Id == orderId,
                _session,
                beforeSave: (save, _) =>
                {
                    ConcurrencySimulation.EnsureCurrentRevision(SharedOptions, orderId, expectedRevision);
                    _tracked = save.Entity;
                    _tracked.Revision++;
                    _preview.InvalidateEntity();
                    _applyResult = save.ApplyResult;
                    _modifiedRows = Case5.PlaygroundEfPresentation.CollectModifiedRows(_db);
                    _entityJsonAfterApply = EntityJson;
                    return Task.CompletedTask;
                }
            );

            if (outcome.Stage == SparseEntityPipelineStage.RebaseConflict)
            {
                await RecoverFromConflict(
                    snapshot.Submitted,
                    snapshot.SubmittedDraft,
                    submittedDraftAfterSubmit,
                    expectedRevision,
                    conflictHandlingMode);
                return;
            }

            if (outcome.Stage == SparseEntityPipelineStage.ReconcileFailed)
            {
                ApplySaveOutcome(outcome);
                return;
            }

            await CompleteLiveDraftSync(
                snapshot.SubmittedDraft,
                submittedDraftAfterSubmit,
                outcome.ReadBack ?? throw new InvalidOperationException("The persisted DTO is not available."),
                localCustomerBeforeSync,
                localNotesBeforeSync
            );
            ApplySaveOutcome(outcome);
        }
        catch (DbUpdateConcurrencyException)
        {
            try
            {
                await RecoverFromConflict(
                    snapshot.Submitted,
                    snapshot.SubmittedDraft,
                    submittedDraftAfterSubmit,
                    expectedRevision,
                    conflictHandlingMode);
            }
            catch (Exception ex)
            {
                SetSaveFailure(true, $"Conflict recovery failed: {FormatException(ex)}");
            }
        }
        catch (Exception ex)
        {
            SetSaveFailure(true, $"Save failed; inspect persisted state before retrying. {FormatException(ex)}");
        }
    }

    private async Task CompleteLiveDraftSync(
        ConcurrentOrderDto submittedDraft,
        ConcurrentOrderDto submittedDraftAfterSubmit,
        ConcurrentOrderDto persisted,
        string localCustomerBeforeSync,
        string localNotesBeforeSync
    )
    {
        _conflictRows = CollectPostSubmitConflicts(
            submittedDraft,
            persisted,
            submittedDraftAfterSubmit);
        var customerUpdatedFromServer =
            !string.Equals(localCustomerBeforeSync, persisted.Customer, StringComparison.Ordinal)
            && string.Equals(_liveDraft.Customer, persisted.Customer, StringComparison.Ordinal);
        var notesUpdatedFromServer =
            !string.Equals(localNotesBeforeSync, persisted.Notes, StringComparison.Ordinal)
            && string.Equals(_liveDraft.Notes, persisted.Notes, StringComparison.Ordinal);
        _latestCustomerUpdate = null;
        _latestNotesUpdate = null;
        _baselineView = persisted;
        _preview.InvalidateBaseline();
        _draftBaseRevision = _tracked?.Revision
            ?? throw new InvalidOperationException("The saved order is no longer tracked.");
        _conflictSubmittedHeader = "Later local draft";
        _conflictVisible = _conflictRows.Count > 0;
        _applyResult = null;
        await ShowServerSyncNoticeAsync(customerUpdatedFromServer, notesUpdatedFromServer);
    }

    private void ApplySaveOutcome(SparseEntityPipelineResult<ConcurrentOrderDto, ConcurrentOrderDto.ChangeSet> outcome)
    {
        _applied = outcome.Stage == SparseEntityPipelineStage.Saved;
        RefreshChanges();
        switch (outcome.Stage)
        {
            case SparseEntityPipelineStage.Saved:
                _conflictSummary = _conflictRows.Count > 0
                    ? "The submitted changes were saved. Later local edits that conflict with persisted values remain in the draft."
                    : string.Empty;
                return;
            case SparseEntityPipelineStage.ReconcileFailed:
                _applied = false;
                _applyResult = null;
                _modifiedRows = [];
                _saveBlocked = true;
                _saveError = "The changes were persisted, but the live draft could not be synchronized. Reseed and review the persisted order before continuing.";
                return;
            case SparseEntityPipelineStage.RebaseConflict:
                _applied = false;
                _applyResult = null;
                _modifiedRows = [];
                _saveError = "The submitted changes conflict with the current order.";
                return;
            default:
                throw new ArgumentOutOfRangeException(nameof(outcome));
        }
    }

    private void SetSaveFailure(bool persistenceMayHaveCompleted, string message)
    {
        _applied = false;
        _applyResult = null;
        _modifiedRows = [];
        RefreshChanges();
        _saveError = message;
        if (persistenceMayHaveCompleted)
        {
            _saveBlocked = true;
        }
    }

    private static string FormatException(Exception? exception) =>
        exception is null ? "Unknown error." : $"{exception.GetType().Name}: {exception.Message}";

    private List<(
        SparsePath? Path,
        string PathText,
        string Baseline,
        string Submitted,
        string Current,
        string Kind,
        bool CanResolve,
        bool? UseSubmitted
    )> CollectPostSubmitConflicts(
        ConcurrentOrderDto submittedDraft,
        ConcurrentOrderDto persisted,
        ConcurrentOrderDto submittedDraftAfterSubmit
    )
    {
        var postSubmit = submittedDraft.CreateChangeSet(submittedDraftAfterSubmit);
        var postSubmitRebase = postSubmit.RebaseOnto(persisted);
        return postSubmitRebase.Conflicts
            .Select(static conflict => (
                Path: (SparsePath?)conflict.Path,
                PathText: conflict.PathText,
                Baseline: Case5.PlaygroundEfPresentation.FormatChangeValue(conflict.BaseValue),
                Submitted: Case5.PlaygroundEfPresentation.FormatChangeValue(conflict.LocalValue),
                Current: Case5.PlaygroundEfPresentation.FormatChangeValue(conflict.CurrentValue),
                Kind: conflict.Kind.ToString(),
                CanResolve: false,
                UseSubmitted: (bool?)null))
            .ToList();
    }

    private async Task RecoverFromConflict(
        ConcurrentOrderDto.ChangeSet submitted,
        ConcurrentOrderDto submittedDraft,
        ConcurrentOrderDto submittedDraftAfterSubmit,
        int expectedRevision,
        ConflictHandlingMode conflictHandlingMode
    )
    {
        if (_db is null || _tracked is null)
        {
            throw new InvalidOperationException("The EF Core demo store is not initialized.");
        }

        var orderId = _tracked.Id;
        _db.ChangeTracker.Clear();
        _tracked = _db.Orders
            .Include(static order => order.Note)
            .Single(order => order.Id == orderId);
        _preview.InvalidateEntity();
        if (_mapper is null)
        {
            throw new InvalidOperationException("The EF Core mapper is not initialized.");
        }

        var current = await ReadAuthoritativeDtoAsync(orderId);
        if (conflictHandlingMode == ConflictHandlingMode.Strict)
        {
            // Reject the whole submission.
            _session = current.CreateEditSession(_liveDraft);
            _baselineView = current;
            _preview.InvalidateBaseline();
            _draftBaseRevision = _tracked.Revision;
            ClearConflictResolution();
            _conflictSubmittedHeader = "Submitted changes";
            _conflictRows =
            [
                (
                    Path: (SparsePath?)null,
                    PathText: "Revision",
                    Baseline: expectedRevision.ToString(),
                    Submitted: "Submitted changes",
                    Current: _tracked.Revision.ToString(),
                    Kind: "Strict rejection",
                    CanResolve: false,
                    UseSubmitted: (bool?)null
                ),
            ];
            _conflictSummary = "Strict handling rejected the submitted changes because the order revision changed. The draft remains available for another save.";
            _applied = false;
            _applyResult = null;
            _modifiedRows = [];
            RefreshChanges();
            _conflictVisible = true;
            return;
        }

        var submittedRebase = submitted.RebaseOnto(current);
        if (submittedRebase.HasConflicts)
        {
            _conflictResolution = ConcurrentOrderDto.ChangeSet.BeginResolution(
                submittedRebase,
                current
            );
            _resolutionSubmitted = submitted;
            _resolutionSubmittedDraft = submittedDraft;
            _resolutionExpectedRevision = _tracked.Revision;
            _resolutionOrderId = orderId;
            _resolutionStale = false;
            _conflictSubmittedHeader = "Captured submitted value";
            // Rebase the live session onto the same current snapshot the
            // resolution builds against. Without this, the apply-time
            // reconciliation validates the resolved transition (based on
            // current) against the stale pre-conflict baseline and fails
            // deterministically, leaving the dialog stuck with "do not retry".
            _session = current.CreateEditSession(_liveDraft);
            _baselineView = current;
            _preview.InvalidateBaseline();
            _draftBaseRevision = _tracked.Revision;
            _conflictRows = submittedRebase.Conflicts
                .Select(static conflict => (
                    Path: (SparsePath?)conflict.Path,
                    PathText: conflict.PathText,
                    Baseline: Case5.PlaygroundEfPresentation.FormatChangeValue(conflict.BaseValue),
                    Submitted: Case5.PlaygroundEfPresentation.FormatChangeValue(conflict.LocalValue),
                    Current: Case5.PlaygroundEfPresentation.FormatChangeValue(conflict.CurrentValue),
                    Kind: conflict.Kind.ToString(),
                    CanResolve: true,
                    UseSubmitted: (bool?)null))
                .ToList();
            _conflictSummary = "Another user changed fields in the submitted snapshot. Choose the captured value or the current persisted value for each conflict before applying the non-conflicting changes.";
            _applied = false;
            _applyResult = null;
            _modifiedRows = [];
            RefreshChanges();
            _conflictVisible = true;
            return;
        }

        // Retry only the rebased submission; post-submit edits stay out of the
        // write and are merged back by the shared reconciliation path.
        var retryRevision = _tracked.Revision;
        var localCustomerBeforeSync = _liveDraft.Customer;
        var localNotesBeforeSync = _liveDraft.Notes;
        _entityJsonBeforeApply = EntityJson;
        var outcome = await _mapper.PipelineExecuteAsync(
            _db,
            submittedRebase.Rebased,
            order => order.Id == orderId,
            new SessionPipelineAdapter(_session, submitted),
            beforeSave: (save, _) =>
            {
                ConcurrencySimulation.EnsureCurrentRevision(SharedOptions, orderId, retryRevision);
                _tracked = save.Entity;
                if (_db.ChangeTracker.HasChanges())
                {
                    _tracked.Revision++;
                }
                _preview.InvalidateEntity();
                _applyResult = save.ApplyResult;
                _modifiedRows = Case5.PlaygroundEfPresentation.CollectModifiedRows(_db);
                _entityJsonAfterApply = EntityJson;
                return Task.CompletedTask;
            }
        );

        if (outcome.Stage == SparseEntityPipelineStage.Saved)
        {
            await CompleteLiveDraftSync(
                submittedDraft,
                submittedDraftAfterSubmit,
                outcome.ReadBack ?? throw new InvalidOperationException("The persisted DTO is not available."),
                localCustomerBeforeSync,
                localNotesBeforeSync
            );
            ClearConflictResolution();
            _conflictSubmittedHeader = "Later local draft";
            _conflictSummary = _conflictRows.Count > 0
                ? "The submitted changes were saved. Later local edits that conflict with the persisted order remain in the draft and were not overwritten."
                : "Another user updated this order while the save was pending. The submitted changes were saved on top of the latest entity.";
            _applied = true;
            RefreshChanges();
            _conflictVisible = _conflictRows.Count > 0;
            return;
        }

        ApplySaveOutcome(outcome);
        if (outcome.Stage == SparseEntityPipelineStage.RebaseConflict)
        {
            _saveError = "The rebased save encountered another change. No further retry was attempted; review the current order before saving again.";
        }
    }

    private void UseSubmittedConflictValue(string pathText) => SetConflictChoice(pathText, true);

    private void UseCurrentConflictValue(string pathText) => SetConflictChoice(pathText, false);

    private void SetConflictChoice(string pathText, bool useSubmitted)
    {
        if (IsSaveApplying || _saveBlocked)
        {
            return;
        }

        var index = _conflictRows.FindIndex(row => row.CanResolve && row.PathText == pathText);
        if (index < 0 || _conflictResolution is null)
        {
            throw new InvalidOperationException($"No resolvable conflict exists at '{pathText}'.");
        }

        var row = _conflictRows[index];
        if (row.Path is not SparsePath path)
        {
            throw new InvalidOperationException($"The conflict at '{pathText}' has no typed path.");
        }

        if (useSubmitted)
        {
            _conflictResolution.UseIncoming(path);
        }
        else
        {
            _conflictResolution.UseCurrent(path);
        }

        _conflictRows[index] = (
            row.Path,
            row.PathText,
            row.Baseline,
            row.Submitted,
            row.Current,
            row.Kind,
            row.CanResolve,
            useSubmitted
        );
    }

    private async Task ApplyConflictResolution()
    {
        if (
            !CanApplyResolution
            || _conflictResolution is null
            || _resolutionSubmitted is null
            || _resolutionSubmittedDraft is null
        )
        {
            return;
        }

        if (!_conflictResolution.TryBuild(out var resolved, out var failure) || resolved is null)
        {
            _conflictSummary = failure?.Reason ?? "The selected conflict resolutions could not be built.";
            return;
        }

        var submitted = _resolutionSubmitted;
        var submittedDraft = _resolutionSubmittedDraft;
        var submittedDraftAfterSubmit = _liveDraft.DeepClone();
        var orderId = _resolutionOrderId;
        var expectedRevision = _resolutionExpectedRevision;
        _resolutionApplying = true;
        _saveError = null;
        await _storeGate.WaitAsync();
        try
        {
            if (_db is null || _tracked is null || _mapper is null)
            {
                throw new InvalidOperationException("The EF Core demo store is not initialized.");
            }

            ConcurrencySimulation.EnsureCurrentRevision(SharedOptions, orderId, expectedRevision);
            if (_tracked.Id != orderId || _tracked.Revision != expectedRevision)
            {
                throw new DbUpdateConcurrencyException(
                    $"Order {orderId} is no longer at revision {expectedRevision}."
                );
            }

            var localCustomerBeforeSync = _liveDraft.Customer;
            var localNotesBeforeSync = _liveDraft.Notes;
            _entityJsonBeforeApply = EntityJson;
            var outcome = await _mapper.PipelineExecuteAsync(
                _db,
                resolved,
                order => order.Id == orderId,
                // The session was rebased onto the same current snapshot the
                // resolution builds against (see RecoverFromConflict), so the
                // resolved transition reconciles directly. Substituting the
                // original submission here (as SessionPipelineAdapter does for the
                // non-conflict path) would validate its stale Before
                // images against the rebased baseline and fail deterministically.
                _session,
                beforeSave: (save, _) =>
                {
                    ConcurrencySimulation.EnsureCurrentRevision(SharedOptions, orderId, expectedRevision);
                    _tracked = save.Entity;
                    if (_db.ChangeTracker.HasChanges())
                    {
                        _tracked.Revision++;
                    }
                    _preview.InvalidateEntity();
                    _applyResult = save.ApplyResult;
                    _modifiedRows = Case5.PlaygroundEfPresentation.CollectModifiedRows(_db);
                    _entityJsonAfterApply = EntityJson;
                    return Task.CompletedTask;
                }
            );

            if (outcome.Stage == SparseEntityPipelineStage.Saved)
            {
                await CompleteLiveDraftSync(
                    submittedDraft,
                    submittedDraftAfterSubmit,
                    outcome.ReadBack
                        ?? throw new InvalidOperationException("The persisted DTO is not available."),
                    localCustomerBeforeSync,
                    localNotesBeforeSync
                );
                _conflictSubmittedHeader = "Later local draft";
                _conflictSummary = _conflictRows.Count > 0
                    ? "The selected values were applied. Later local edits that conflict with the persisted order remain in the draft and were not overwritten."
                    : "The selected conflict values and non-conflicting submitted changes were applied.";
                _applied = true;
                ClearConflictResolution();
                RefreshChanges();
                _conflictVisible = _conflictRows.Count > 0;
                return;
            }

            if (outcome.Stage == SparseEntityPipelineStage.RebaseConflict)
            {
                _applied = false;
                _applyResult = null;
                _modifiedRows = [];
                await RecoverFromConflict(
                    submitted,
                    submittedDraft,
                    submittedDraftAfterSubmit,
                    expectedRevision,
                    ConflictHandlingMode.Standard);
                return;
            }

            ApplySaveOutcome(outcome);
            if (outcome.Stage == SparseEntityPipelineStage.ReconcileFailed)
            {
                _resolutionStale = true;
                _conflictVisible = true;
                _conflictSummary = "The chosen values were persisted, but the live draft could not be synchronized. Reseed and review the persisted order; do not retry this submission.";
            }
        }
        catch (DbUpdateConcurrencyException)
        {
            _applied = false;
            _applyResult = null;
            _modifiedRows = [];
            try
            {
                await RecoverFromConflict(
                    submitted,
                    submittedDraft,
                    submittedDraftAfterSubmit,
                    expectedRevision,
                    ConflictHandlingMode.Standard);
            }
            catch (Exception ex)
            {
                SetSaveFailure(true, $"Conflict recovery failed: {FormatException(ex)}");
                _conflictVisible = true;
            }
        }
        catch (Exception ex)
        {
            SetSaveFailure(true, $"Conflict resolution failed; inspect persisted state before retrying. {FormatException(ex)}");
            _conflictVisible = true;
        }
        finally
        {
            _storeGate.Release();
            _resolutionApplying = false;
        }
    }

    private async Task<ConcurrentOrderDto> ReadAuthoritativeDtoAsync(int orderId)
    {
        if (_db is null || _mapper is null)
        {
            throw new InvalidOperationException("The EF Core mapper is not initialized.");
        }

        return await _db.Orders
            .AsNoTracking()
            .Where(order => order.Id == orderId)
            .Select(_mapper.Projection)
            .SingleAsync();
    }

    private void ClearConflictResolution()
    {
        _conflictResolution = null;
        _resolutionSubmitted = null;
        _resolutionSubmittedDraft = null;
        _resolutionExpectedRevision = 0;
        _resolutionOrderId = 0;
        _resolutionStale = false;
        _resolutionApplying = false;
    }

    private void CloseConflictDialog()
    {
        if (IsSaveApplying)
        {
            return;
        }

        _conflictVisible = false;
        ClearConflictResolution();
    }

    private sealed class SessionPipelineAdapter : ISparseEditSessionPipeline<ConcurrentOrderDto, ConcurrentOrderDto.ChangeSet>
    {
        private readonly ISparseEditSessionPipeline<ConcurrentOrderDto, ConcurrentOrderDto.ChangeSet> _session;
        private readonly ConcurrentOrderDto.ChangeSet _submitted;

        public SessionPipelineAdapter(
            ISparseEditSessionPipeline<ConcurrentOrderDto, ConcurrentOrderDto.ChangeSet> session,
            ConcurrentOrderDto.ChangeSet submitted
        )
        {
            _session = session;
            _submitted = submitted;
        }

        // Rebased writes use a new baseline; reconciliation must acknowledge the original submission.
        public bool TryReconcileForPipeline(
            ConcurrentOrderDto.ChangeSet _,
            ConcurrentOrderDto persisted,
            out IReadOnlyList<SparseConflict>? conflicts
        ) => _session.TryReconcileForPipeline(_submitted, persisted, out conflicts);
    }
}
