<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <AssemblyName>EfCoreSample.Server</AssemblyName>
    <RootNamespace>EfCoreSample.Server</RootNamespace>
    <OpenApiGenerateDocumentsOnBuild>true</OpenApiGenerateDocumentsOnBuild>
    <OpenApiDocumentsDirectory>$(MSBuildProjectDirectory)/obj/openapi</OpenApiDocumentsDirectory>
    <OpenApiGenerateDocumentsOptions>--file-name order-api --document-name v1</OpenApiGenerateDocumentsOptions>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.ApiDescription.Server" Version="10.0.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.13" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.3.1" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../EfCoreSample.Contracts/EfCoreSample.Contracts.csproj" />
    <ProjectReference Include="../../../src/SparseTypes.EntityFrameworkCore/SparseTypes.EntityFrameworkCore.csproj" />
    <ProjectReference Include="../../../src/SparseTypes.OpenApi.AspNetCore/SparseTypes.OpenApi.AspNetCore.csproj" />
    <ProjectReference
      Include="../../../src/SparseTypes.Generator/SparseTypes.Generator.csproj"
      OutputItemType="Analyzer"
      ReferenceOutputAssembly="false"
    />
  </ItemGroup>
  <Target Name="GenerateWebClientApiTypes" AfterTargets="GenerateOpenApiDocuments" Condition="'$(DesignTimeBuild)' != 'true'">
    <Exec
      WorkingDirectory="$(MSBuildProjectDirectory)/../EfCoreSample.WebClient"
      Command="npm run generate:api"
    />
  </Target>
</Project>
