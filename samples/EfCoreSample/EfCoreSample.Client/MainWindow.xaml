<Window
  x:Class="EfCoreSample.Client.MainWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  Title="EfCoreSample Order Editor"
  Width="880"
  Height="660"
>
  <DockPanel Margin="12">
    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8" Orientation="Horizontal">
      <TextBlock VerticalAlignment="Center" Text="Order Id:" />
      <TextBox
        Width="60"
        Margin="4,0,0,0"
        VerticalAlignment="Center"
        Text="{Binding OrderIdText, UpdateSourceTrigger=PropertyChanged}"
      />
      <Button
        Margin="8,0,0,0"
        Padding="12,2"
        Click="OnLoadClick"
        Content="Load"
        IsEnabled="{Binding IsIdle}"
      />
      <Button
        Margin="8,0,0,0"
        Padding="12,2"
        Click="OnSaveClick"
        Content="Save"
        IsEnabled="{Binding CanSave}"
      />
      <Button
        Margin="8,0,0,0"
        Padding="12,2"
        Click="OnAddLineClick"
        Content="Add line"
        IsEnabled="{Binding HasSession}"
      />
      <Button
        Margin="8,0,0,0"
        Padding="12,2"
        Click="OnRemoveLineClick"
        Content="Remove line"
        IsEnabled="{Binding CanRemoveLine}"
      />
    </StackPanel>

    <TextBlock
      DockPanel.Dock="Bottom"
      Margin="0,8,0,0"
      Text="{Binding Status}"
      TextWrapping="Wrap"
    />

    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <Grid Grid.Row="0" Margin="0,0,0,8">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock
          Grid.Row="0"
          Grid.Column="0"
          Margin="0,2,8,2"
          VerticalAlignment="Center"
          Text="Name:"
        />
        <TextBox
          Grid.Row="0"
          Grid.Column="1"
          Margin="0,2,12,2"
          Text="{Binding Session.Observable.Name, UpdateSourceTrigger=PropertyChanged}"
        />
        <TextBlock
          Grid.Row="0"
          Grid.Column="2"
          Margin="0,2,8,2"
          VerticalAlignment="Center"
          Text="Code:"
        />
        <TextBox
          Grid.Row="0"
          Grid.Column="3"
          Margin="0,2,0,2"
          Text="{Binding Session.Observable.Code, UpdateSourceTrigger=PropertyChanged}"
        />

        <TextBlock
          Grid.Row="1"
          Grid.Column="0"
          Margin="0,2,8,2"
          VerticalAlignment="Center"
          Text="Notes:"
        />
        <TextBox
          Grid.Row="1"
          Grid.Column="1"
          Margin="0,2,12,2"
          Text="{Binding Session.Observable.Notes, UpdateSourceTrigger=PropertyChanged}"
        />
        <TextBlock
          Grid.Row="1"
          Grid.Column="2"
          Margin="0,2,8,2"
          VerticalAlignment="Center"
          Text="Ship city:"
        />
        <TextBox
          Grid.Row="1"
          Grid.Column="3"
          Margin="0,2,0,2"
          Text="{Binding Session.Observable.ShipCity, UpdateSourceTrigger=PropertyChanged}"
        />

        <TextBlock
          Grid.Row="2"
          Grid.Column="0"
          Margin="0,2,8,2"
          VerticalAlignment="Center"
          Text="Street:"
        />
        <TextBox
          Grid.Row="2"
          Grid.Column="1"
          Margin="0,2,12,2"
          Text="{Binding Session.Observable.Address.Street, UpdateSourceTrigger=PropertyChanged}"
        />
        <TextBlock
          Grid.Row="2"
          Grid.Column="2"
          Margin="0,2,8,2"
          VerticalAlignment="Center"
          Text="City:"
        />
        <TextBox
          Grid.Row="2"
          Grid.Column="3"
          Margin="0,2,0,2"
          Text="{Binding Session.Observable.Address.City, UpdateSourceTrigger=PropertyChanged}"
        />

        <TextBlock
          Grid.Row="3"
          Grid.Column="0"
          Margin="0,2,8,2"
          VerticalAlignment="Center"
          Text="Total:"
        />
        <TextBox
          Grid.Row="3"
          Grid.Column="1"
          Margin="0,2,12,2"
          IsReadOnly="True"
          Text="{Binding Session.Observable.DisplayTotal, Mode=OneWay}"
        />
        <TextBlock
          Grid.Row="3"
          Grid.Column="2"
          Margin="0,2,8,2"
          VerticalAlignment="Center"
          Text="Version:"
        />
        <TextBox
          Grid.Row="3"
          Grid.Column="3"
          Margin="0,2,0,2"
          IsReadOnly="True"
          Text="{Binding Session.Observable.Version, Mode=OneWay}"
        />
      </Grid>

      <DataGrid
        Grid.Row="1"
        AutoGenerateColumns="False"
        CanUserAddRows="False"
        IsReadOnly="False"
        ItemsSource="{Binding Session.Observable.Lines}"
        SelectedIndex="{Binding SelectedLineIndex}"
      >
        <DataGrid.Columns>
          <DataGridTextColumn Binding="{Binding Id, Mode=OneWay}" Header="Id" IsReadOnly="True" />
          <DataGridTextColumn Binding="{Binding Quantity}" Header="Quantity" />
          <DataGridTextColumn Binding="{Binding UnitPrice}" Header="Unit price" />
          <DataGridTextColumn
            Binding="{Binding Subtotal, Mode=OneWay}"
            Header="Subtotal"
            IsReadOnly="True"
          />
          <DataGridTextColumn
            Binding="{Binding TemporaryId, Mode=OneWay}"
            Header="Temporary id"
            IsReadOnly="True"
          />
        </DataGrid.Columns>
      </DataGrid>

      <TextBlock Grid.Row="2" Margin="0,8,0,0" Text="{Binding ConflictsText}" TextWrapping="Wrap" />
    </Grid>
  </DockPanel>
</Window>
