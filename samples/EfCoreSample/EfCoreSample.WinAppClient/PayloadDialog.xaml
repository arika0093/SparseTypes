<Window
  x:Class="EfCoreSample.WinAppClient.PayloadDialog"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  Title="Change payload"
  Width="640"
  Height="480"
  FontSize="14"
  WindowStartupLocation="CenterOwner"
>
  <DockPanel Margin="12">
    <TextBlock
      DockPanel.Dock="Top"
      Margin="0,0,0,8"
      Text="The JSON body sent with the next save (If-Match carries the version)."
      TextWrapping="Wrap"
    />
    <Button
      DockPanel.Dock="Bottom"
      Margin="0,8,0,0"
      HorizontalAlignment="Right"
      MinWidth="96"
      Padding="12,4"
      Content="Close"
      IsCancel="True"
      IsDefault="True"
    />
    <TextBox
      FontFamily="Consolas, monospace"
      IsReadOnly="True"
      Text="{Binding Json, Mode=OneWay}"
      TextWrapping="NoWrap"
      VerticalScrollBarVisibility="Auto"
      HorizontalScrollBarVisibility="Auto"
    />
  </DockPanel>
</Window>
