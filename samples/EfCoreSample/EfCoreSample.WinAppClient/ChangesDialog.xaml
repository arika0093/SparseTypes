<Window
  x:Class="EfCoreSample.WinAppClient.ChangesDialog"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  Title="Pending changes"
  Width="720"
  Height="460"
  FontSize="14"
  WindowStartupLocation="CenterOwner"
>
  <DockPanel Margin="12">
    <TextBlock DockPanel.Dock="Top" Margin="0,0,0,8" Text="{Binding Summary}" TextWrapping="Wrap" />
    <Button
      DockPanel.Dock="Bottom"
      Margin="0,8,0,0"
      HorizontalAlignment="Right"
      MinWidth="96"
      Padding="12,4"
      Content="Close"
      IsCancel="True"
      IsDefault="True"
    />
    <DataGrid
      AutoGenerateColumns="False"
      CanUserAddRows="False"
      CanUserDeleteRows="False"
      IsReadOnly="True"
      ItemsSource="{Binding Rows}"
    >
      <DataGrid.Columns>
        <DataGridTextColumn Binding="{Binding PathText}" Header="Field" />
        <DataGridTextColumn Binding="{Binding Operation}" Header="Change" />
        <DataGridTextColumn Binding="{Binding BeforeText}" Header="Before" />
        <DataGridTextColumn Binding="{Binding AfterText}" Header="After" />
      </DataGrid.Columns>
    </DataGrid>
  </DockPanel>
</Window>
